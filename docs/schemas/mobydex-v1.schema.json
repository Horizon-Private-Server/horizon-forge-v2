{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://horizon-forge.invalid/schemas/mobydex-v1.schema.json",
  "title": "Horizon Forge MobyDex entry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "game", "oClass", "name", "pvar"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "game": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]{1,15}$" },
    "oClass": { "type": "integer", "minimum": 0, "maximum": 65535 },
    "name": { "$ref": "#/$defs/label" },
    "description": { "type": "string", "maxLength": 2048 },
    "tags": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 64 }
    },
    "pvar": { "$ref": "#/$defs/pvar" }
  },
  "$defs": {
    "key": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "pvar": {
      "type": "object",
      "additionalProperties": false,
      "required": ["length", "fields"],
      "properties": {
        "length": { "type": "integer", "minimum": 0, "maximum": 1048576 },
        "defaultHex": {
          "type": "string",
          "pattern": "^[0-9A-Fa-f]*$",
          "maxLength": 2097152
        },
        "relocations": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "multipleOf": 4 }
        },
        "fields": {
          "type": "array",
          "maxItems": 4096,
          "items": { "$ref": "#/$defs/field" }
        }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "offset", "length", "definition"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/label" },
        "offset": { "type": "integer", "minimum": 0 },
        "length": { "type": "integer", "minimum": 1, "maximum": 1048576 },
        "help": { "type": "string", "maxLength": 1024 },
        "minimum": { "type": "number" },
        "maximum": { "type": "number" },
        "definition": { "$ref": "#/$defs/definition" }
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "label", "value"],
      "properties": {
        "key": { "$ref": "#/$defs/key" },
        "label": { "$ref": "#/$defs/label" },
        "value": { "type": "integer" }
      }
    },
    "integerStorage": {
      "enum": ["int8", "uint8", "int16", "uint16", "int32", "uint32"]
    },
    "definition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": [
                "int8", "uint8", "int16", "uint16", "int32", "uint32", "int64", "uint64",
                "float32", "float64", "bool8", "bool32", "rgb8", "rgba8",
                "vector2f32", "vector3f32", "vector4f32", "bytes"
              ]
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "storage", "options"],
          "properties": {
            "kind": { "enum": ["enum", "flags"] },
            "storage": { "$ref": "#/$defs/integerStorage" },
            "options": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": { "$ref": "#/$defs/option" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "storage", "domain", "targetKind", "nullValue"],
          "properties": {
            "kind": { "const": "reference" },
            "storage": { "$ref": "#/$defs/integerStorage" },
            "domain": { "enum": ["entity", "asset"] },
            "targetKind": { "$ref": "#/$defs/key" },
            "nullValue": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "count", "stride", "element"],
          "properties": {
            "kind": { "const": "array" },
            "count": { "type": "integer", "minimum": 1, "maximum": 65536 },
            "stride": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "element": { "$ref": "#/$defs/definition" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fields"],
          "properties": {
            "kind": { "const": "struct" },
            "fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4096,
              "items": { "$ref": "#/$defs/field" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fields"],
          "properties": {
            "kind": { "const": "union" },
            "fields": {
              "type": "array",
              "minItems": 2,
              "maxItems": 4096,
              "items": { "$ref": "#/$defs/field" }
            }
          }
        }
      ]
    }
  }
}
