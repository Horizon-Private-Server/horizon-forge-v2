<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>2.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <Import Project="../../build/RatchetSdk.props" />

  <ItemGroup Condition="'$(RatchetSdkRoot)' != ''">
    <ProjectReference Include="$(RatchetSdkRoot)/src/RatchetPs2.Sdk/RatchetPs2.Sdk.csproj" />
    <AssemblyMetadata Include="RatchetSdkRevision" Value="$(RatchetSdkRevision)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Forge.Host.ProtocolTests" />
    <EmbeddedResource Include="Games/UYA/MobyDex/dataset.json"
                      LogicalName="Forge.Host.Games.UYA.MobyDex.dataset.json" />
    <EmbeddedResource Include="Games/UYA/GroupTemplates/dataset.json"
                      LogicalName="Forge.Host.Games.UYA.GroupTemplates.dataset.json" />
  </ItemGroup>

  <PropertyGroup Condition="'$(ForgeEnableOcclusionCoveragePreview)' == 'true'">
    <DefineConstants>$(DefineConstants);FORGE_OCCLUSION_COVERAGE_PREVIEW</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(ForgeEnableOcclusionCoveragePreview)' != 'true'">
    <Compile Remove="Games/UYA/UyaOcclusionCoveragePreviewService.cs" />
  </ItemGroup>
  <PropertyGroup Condition="'$(ForgeEnableOcclusionCoverageGeneration)' == 'true'">
    <DefineConstants>$(DefineConstants);FORGE_OCCLUSION_COVERAGE_GENERATION</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ForgeEnableOcclusionCoverageGraphShapes)' == 'true'">
    <DefineConstants>$(DefineConstants);FORGE_OCCLUSION_COVERAGE_GRAPH_SHAPES</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(ForgeEnableOcclusionCoverageGeneration)' != 'true'">
    <Compile Remove="Games/UYA/UyaOcclusionCoverageGenerationService.cs" />
  </ItemGroup>

  <Target Name="ValidateRatchetSdk" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(RatchetSdkRoot)' == ''"
           Text="Ratchet SDK is not configured. Run: bash scripts/bootstrap-ratchet-sdk.sh" />
    <Error Condition="!Exists('$(RatchetSdkRoot)/src/RatchetPs2.Sdk/RatchetPs2.Sdk.csproj')"
           Text="Ratchet SDK project is missing below configured root: $(RatchetSdkRoot)" />
  </Target>
</Project>
