{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "rootDir": "src",
    "outDir": "dist-electron",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": ["src/main", "src/preload"]
}
