diff --git a/src/RatchetPs2.Core/LevelAssets/LevelAssetInventoryReader.cs b/src/RatchetPs2.Core/LevelAssets/LevelAssetInventoryReader.cs
new file mode 100644
index 0000000..dc25551
--- /dev/null
+++ b/src/RatchetPs2.Core/LevelAssets/LevelAssetInventoryReader.cs
@@ -0,0 +1,99 @@
+using RatchetPs2.Core.IO;
+using RatchetPs2.Core.Wad;
+
+namespace RatchetPs2.Core.LevelAssets;
+
+public static class LevelAssetInventoryReader
+{
+    public static LevelAssetExtractionResult Extract(byte[] headerBytes, byte[] paletteBytes, byte[] assetWadBytes)
+    {
+        var header = LevelAssetReader.ReadHeader(headerBytes);
+        var assetBytes = BinaryMagic.IsWad(assetWadBytes)
+            ? WadCompression.Decompress(assetWadBytes)
+            : assetWadBytes;
+        var mobys = LevelAssetReader.ReadModelDefinitions(headerBytes, header.MobyModelOffset, header.MobyModelCount);
+        var ties = LevelAssetReader.ReadModelDefinitions(headerBytes, header.TieModelOffset, header.TieModelCount);
+        var shrubs = LevelAssetReader.ReadShrubDefinitions(headerBytes, header.ShrubModelOffset, header.ShrubModelCount);
+        var knownOffsets = LevelAssetReader.CollectKnownAssetOffsets(
+            header, assetBytes.Length, mobys, ties, shrubs, [header.SceneViewSize]);
+        var mipmaps = LevelAssetReader.ReadMipmapDefinitions(
+            headerBytes, header.GsRamOffset, Math.Max(0, header.GsRamCount + header.ExtraMipmapCount));
+        var gsStash = mipmaps.Skip(header.GsRamCount).ToArray();
+        var mobyTextures = LevelAssetReader.ReadTextureDefinitions(
+            headerBytes, header.MobyTextureOffset, header.MobyTextureCount);
+        var tieTextures = LevelAssetReader.ReadTextureDefinitions(
+            headerBytes, header.TieTextureOffset, header.TieTextureCount);
+        var shrubTextures = LevelAssetReader.ReadTextureDefinitions(
+            headerBytes, header.ShrubTextureOffset, header.ShrubTextureCount);
+        var assets = new List<ExtractedLevelAsset>(mobys.Count + ties.Count + shrubs.Count);
+        var failures = 0;
+
+        foreach (var definition in mobys)
+        {
+            try
+            {
+                Add(assets, FrontendAssetKind.Moby, definition.ModelId, definition.Index,
+                    headerBytes.AsSpan(header.MobyModelOffset + definition.Index * 0x20, 0x20).ToArray(),
+                    LevelAssetReader.ReadAssetSlice(assetBytes, definition.ModelOffset, knownOffsets),
+                    LevelAssetTextureExtractor.Extract("moby", definition.TextureIds, mobyTextures, paletteBytes, assetBytes,
+                        header.TextureDataOffset, gsStash, isSwizzled: false));
+            }
+            catch (Exception exception) when (IsUnsupportedAsset(exception))
+            {
+                failures++;
+            }
+        }
+        foreach (var definition in ties)
+        {
+            try
+            {
+                Add(assets, FrontendAssetKind.Tie, definition.ModelId, definition.Index,
+                    headerBytes.AsSpan(header.TieModelOffset + definition.Index * 0x20, 0x20).ToArray(),
+                    LevelAssetReader.ReadAssetSlice(assetBytes, definition.ModelOffset, knownOffsets),
+                    LevelAssetTextureExtractor.Extract("tie", definition.TextureIds, tieTextures, paletteBytes, assetBytes,
+                        header.TextureDataOffset, null, isSwizzled: false));
+            }
+            catch (Exception exception) when (IsUnsupportedAsset(exception))
+            {
+                failures++;
+            }
+        }
+        foreach (var definition in shrubs)
+        {
+            try
+            {
+                var textures = LevelAssetTextureExtractor.Extract("shrub", definition.TextureIds, shrubTextures, paletteBytes,
+                    assetBytes, header.TextureDataOffset, null, isSwizzled: false).ToList();
+                if (definition.Width > 0 && definition.Height > 0 && definition.TextureId > 0)
+                    textures.Add(new(1, LevelAssetReader.BuildShrubBillboardTexture(definition, paletteBytes).PifBytes));
+                Add(assets, FrontendAssetKind.Shrub, definition.ModelId, definition.Index,
+                    headerBytes.AsSpan(header.ShrubModelOffset + definition.Index * 0x30, 0x30).ToArray(),
+                    LevelAssetReader.ReadAssetSlice(assetBytes, definition.ModelOffset, knownOffsets), textures);
+            }
+            catch (Exception exception) when (IsUnsupportedAsset(exception))
+            {
+                failures++;
+            }
+        }
+        var sky = LevelAssetReader.ReadAssetSlice(assetBytes, header.SkyOffset, knownOffsets);
+        return new(assets, failures)
+        {
+            SkyboxBytes = sky.Length == 0 ? null : sky,
+        };
+    }
+
+    private static void Add(
+        ICollection<ExtractedLevelAsset> assets,
+        FrontendAssetKind kind,
+        int classId,
+        int sourceIndex,
+        byte[] definitionBytes,
+        byte[] modelBytes,
+        IReadOnlyList<ExtractedLevelAssetTexture> textures)
+    {
+        assets.Add(new(kind, classId, sourceIndex, definitionBytes, modelBytes, textures));
+    }
+
+    private static bool IsUnsupportedAsset(Exception exception) => exception is
+        ArgumentException or InvalidDataException or IOException or NotSupportedException or OverflowException;
+}
diff --git a/src/RatchetPs2.Core/LevelAssets/StandardFrontendAssetPackageBuilder.cs b/src/RatchetPs2.Core/LevelAssets/StandardFrontendAssetPackageBuilder.cs
new file mode 100644
index 0000000..850bae8
--- /dev/null
+++ b/src/RatchetPs2.Core/LevelAssets/StandardFrontendAssetPackageBuilder.cs
@@ -0,0 +1,137 @@
+using RatchetPs2.Core.Games;
+using RatchetPs2.Core.Gltf;
+using RatchetPs2.Core.LevelAssets;
+using RatchetPs2.Core.Moby;
+using RatchetPs2.Core.Shrubs;
+using RatchetPs2.Core.Textures;
+using RatchetPs2.Core.Textures.Pif;
+using RatchetPs2.Core.Textures.Png;
+using RatchetPs2.Core.Ties;
+using RatchetPs2.Core.Wad.Models;
+
+namespace RatchetPs2.Core.LevelAssets;
+
+public static class StandardFrontendAssetPackageBuilder
+{
+    public static PackedFilePackage Build(
+        GameId game,
+        FrontendAssetKind kind,
+        byte[] modelBytes,
+        IReadOnlyList<FrontendAssetTexture> textures,
+        bool preserveTieRepeatedTexCoordTiles = false)
+    {
+        ArgumentNullException.ThrowIfNull(modelBytes);
+        ArgumentNullException.ThrowIfNull(textures);
+        if (!Enum.IsDefined(kind)) throw new ArgumentOutOfRangeException(nameof(kind));
+        if (modelBytes.Length == 0) throw new ArgumentException("Asset model bytes cannot be empty.", nameof(modelBytes));
+        if (textures.Any(texture => texture is null || texture.Role > 1 || texture.PifBytes is null))
+            throw new ArgumentException("Asset textures contain an invalid entry.", nameof(textures));
+        if (textures.Count(texture => texture.Role == 1) > 1)
+            throw new ArgumentException("An asset can contain at most one billboard texture.", nameof(textures));
+
+        var files = new List<PackedFile>();
+        var uris = new Dictionary<int, string>();
+        var sizes = new Dictionary<int, TextureSize>();
+        var alpha = new Dictionary<int, TextureAlphaInfo>();
+        TextureResource? billboard = null;
+        var textureIndex = 0;
+        foreach (var texture in textures)
+        {
+            var exported = PifAssetExporter.Export(texture.PifBytes);
+            var resource = new TextureResource(
+                texture.Role == 1 ? "textures/billboard.png" : $"textures/tex.{textureIndex:0000}.png",
+                new(exported.Texture.Header.USize, exported.Texture.Header.VSize),
+                TextureConverter.AnalyzeAlpha(TextureConverter.Decode(exported.Texture)));
+            files.Add(new(resource.Path, exported.PngBytes, "image/png"));
+            if (texture.Role == 1)
+            {
+                billboard = resource;
+                continue;
+            }
+            uris[textureIndex] = resource.Path;
+            sizes[textureIndex] = resource.Size;
+            alpha[textureIndex] = resource.Alpha;
+            textureIndex++;
+        }
+
+        using var input = new MemoryStream(modelBytes, writable: false);
+        var (gltf, buffer) = kind switch
+        {
+            FrontendAssetKind.Moby => ExportMoby(input, uris, sizes, alpha),
+            FrontendAssetKind.Tie => ExportTie(game, input, uris, sizes, alpha, preserveTieRepeatedTexCoordTiles),
+            FrontendAssetKind.Shrub => ExportShrub(game, input, uris, sizes, alpha, billboard),
+            _ => throw new ArgumentOutOfRangeException(nameof(kind)),
+        };
+        files.Add(new("model.gltf", gltf, "model/gltf+json"));
+        files.Add(new("model.buffer.bin", buffer, "application/octet-stream"));
+        return PackedFilePackageBuilder.Pack(files);
+    }
+
+    private static (byte[] Gltf, byte[] Buffer) ExportMoby(
+        Stream input,
+        IReadOnlyDictionary<int, string> uris,
+        IReadOnlyDictionary<int, TextureSize> sizes,
+        IReadOnlyDictionary<int, TextureAlphaInfo> alpha)
+    {
+        var export = MobyGltfExporter.Export(input, "model.gltf", new()
+        {
+            BufferFileName = "model.buffer.bin",
+            LodIndex = 0,
+            SkipAnimationSequences = true,
+            ExternalTextureUris = uris,
+            ExternalTextureSizes = sizes,
+            ExternalTextureAlpha = alpha,
+        });
+        return (export.GltfBytes, export.BinBytes);
+    }
+
+    private static (byte[] Gltf, byte[] Buffer) ExportTie(
+        GameId game,
+        Stream input,
+        IReadOnlyDictionary<int, string> uris,
+        IReadOnlyDictionary<int, TextureSize> sizes,
+        IReadOnlyDictionary<int, TextureAlphaInfo> alpha,
+        bool preserveRepeatedTexCoordTiles)
+    {
+        var export = TieGltfExporter.Export(input, "model.gltf", new()
+        {
+            BufferFileName = "model.buffer.bin",
+            GameProfile = TieGameProfile.ForGame(game),
+            ExternalTextureUris = uris,
+            ExternalTextureSizes = sizes,
+            ExternalTextureAlpha = alpha,
+            PreserveRepeatedTexCoordTiles = preserveRepeatedTexCoordTiles,
+            IncludeDiagnostics = false,
+            Minify = true,
+            MetadataMode = GltfExportMetadataMode.RuntimeOnly,
+        });
+        return (export.GltfBytes, export.BinBytes);
+    }
+
+    private static (byte[] Gltf, byte[] Buffer) ExportShrub(
+        GameId game,
+        Stream input,
+        IReadOnlyDictionary<int, string> uris,
+        IReadOnlyDictionary<int, TextureSize> sizes,
+        IReadOnlyDictionary<int, TextureAlphaInfo> alpha,
+        TextureResource? billboard)
+    {
+        var export = ShrubGltfExporter.Export(input, "model.gltf", new()
+        {
+            BufferFileName = "model.buffer.bin",
+            GameLabel = game.ToString(),
+            ExternalTextureUris = uris,
+            ExternalTextureSizes = sizes,
+            ExternalTextureAlpha = alpha,
+            ExternalBillboardTextureUri = billboard?.Path,
+            ExternalBillboardTextureSize = billboard?.Size,
+            ExternalBillboardTextureAlpha = billboard?.Alpha,
+            IncludeDiagnostics = false,
+            Minify = true,
+            MetadataMode = GltfExportMetadataMode.RuntimeOnly,
+        });
+        return (export.GltfBytes, export.BinBytes);
+    }
+
+    private sealed record TextureResource(string Path, TextureSize Size, TextureAlphaInfo Alpha);
+}
diff --git a/src/RatchetPs2.Core/Sounds/LevelSoundRemapReader.cs b/src/RatchetPs2.Core/Sounds/LevelSoundRemapReader.cs
new file mode 100644
index 0000000..c771d53
--- /dev/null
+++ b/src/RatchetPs2.Core/Sounds/LevelSoundRemapReader.cs
@@ -0,0 +1,120 @@
+using RatchetPs2.Core.LevelAssets;
+using static RatchetPs2.Core.IO.BinarySpanReader;
+
+namespace RatchetPs2.Core.Sounds;
+
+public static class LevelSoundRemapReader
+{
+    private const int HeaderSize = 8;
+    private const int MobyConfigSize = 4;
+    private const int OtherRecordSize = 0x20;
+
+    public static SoundRemapInventory Inspect(
+        ReadOnlySpan<byte> headerBytes,
+        int programCount,
+        CancellationToken cancellationToken = default,
+        IReadOnlyList<int>? secondaryProgramCounts = null)
+    {
+        cancellationToken.ThrowIfCancellationRequested();
+        if (programCount < 0) throw new ArgumentOutOfRangeException(nameof(programCount));
+        var header = LevelAssetReader.ReadHeader(headerBytes);
+        if (header.SoundRemapOffset <= 0 || header.SoundRemapOffset > headerBytes.Length - HeaderSize)
+            throw new InvalidDataException("Level asset header has no bounded sound-remap block.");
+
+        var source = headerBytes[header.SoundRemapOffset..];
+        var otherOffset = ReadNonNegativeInt16(source, 0, "other-record offset");
+        var otherCount = ReadNonNegativeInt16(source, 2, "other-record count");
+        var globalOffset = ReadNonNegativeInt16(source, 4, "global-list offset");
+        var globalCount = ReadNonNegativeInt16(source, 6, "global-list count");
+        if (otherOffset < HeaderSize || (otherOffset - HeaderSize) % MobyConfigSize != 0)
+            throw new InvalidDataException("Level sound-remap moby configuration table is invalid.");
+        var configCount = (otherOffset - HeaderSize) / MobyConfigSize;
+        if (configCount > header.MobyModelCount)
+            throw new InvalidDataException("Level sound remap has more moby configs than model definitions.");
+
+        var definitions = LevelAssetReader.ReadModelDefinitions(
+            headerBytes, header.MobyModelOffset, header.MobyModelCount);
+        var mobys = new SoundMobyRemapInfo[configCount];
+        var end = HeaderSize + configCount * MobyConfigSize;
+        for (var index = 0; index < configCount; index++)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            var configOffset = HeaderSize + index * MobyConfigSize;
+            var listOffset = ReadInt16LittleEndian(source, configOffset);
+            var count = ReadInt16LittleEndian(source, configOffset + 2);
+            if (count < 0 || count > 0 && listOffset <= 0)
+                throw new InvalidDataException($"Level sound-remap moby config {index} is invalid.");
+            SoundSourceRange? slotRange = null;
+            SoundRemapSlotInfo[] slots = [];
+            var bankIndex = -1;
+            if (count > 0)
+            {
+                var bytes = Slice(source, listOffset, checked(count * sizeof(int)), $"moby config {index} list");
+                // The native loader adds one to the leading bank selector; -1 selects the primary bank.
+                bankIndex = ReadInt32LittleEndian(bytes, 0);
+                var selectedProgramCount = programCount;
+                if (bankIndex != -1)
+                {
+                    if (secondaryProgramCounts is null)
+                        throw new NotSupportedException("Level moby sound remaps using secondary banks are not supported.");
+                    if ((uint)bankIndex >= (uint)secondaryProgramCounts.Count || secondaryProgramCounts[bankIndex] < 0)
+                        throw new InvalidDataException("Level moby sound remap selects an unavailable bank.");
+                    selectedProgramCount = secondaryProgramCounts[bankIndex];
+                }
+                slots = ReadSlots(bytes[sizeof(int)..], header.SoundRemapOffset + listOffset + sizeof(int), selectedProgramCount, nullable: true,
+                    $"moby class 0x{definitions[index].ModelId:X4}");
+                slotRange = new(header.SoundRemapOffset + listOffset + sizeof(int), bytes.Length - sizeof(int));
+                end = Math.Max(end, checked(listOffset + bytes.Length));
+            }
+            mobys[index] = new(
+                index,
+                definitions[index].ModelId,
+                listOffset,
+                count,
+                new(header.SoundRemapOffset + configOffset, MobyConfigSize),
+                slotRange,
+                slots) { BankIndex = bankIndex };
+        }
+
+        var otherBytes = Slice(source, otherOffset, checked(otherCount * OtherRecordSize), "other records");
+        var globalBytes = Slice(source, globalOffset, checked(globalCount * sizeof(int)), "global list");
+        var globals = ReadSlots(globalBytes, header.SoundRemapOffset + globalOffset,
+            programCount, nullable: false, "global list");
+        end = Math.Max(end, checked(otherOffset + otherBytes.Length));
+        end = Math.Max(end, checked(globalOffset + globalBytes.Length));
+        return new(
+            new(header.SoundRemapOffset, end),
+            mobys,
+            otherCount,
+            new(header.SoundRemapOffset + otherOffset, otherBytes.Length),
+            globals,
+            new(header.SoundRemapOffset + globalOffset, globalBytes.Length));
+    }
+
+    private static SoundRemapSlotInfo[] ReadSlots(
+        ReadOnlySpan<byte> bytes,
+        int absoluteOffset,
+        int programCount,
+        bool nullable,
+        string owner)
+    {
+        var result = new SoundRemapSlotInfo[bytes.Length / sizeof(int)];
+        for (var index = 0; index < result.Length; index++)
+        {
+            var value = ReadInt32LittleEndian(bytes, index * sizeof(int));
+            if (value >= programCount || value < 0 && !(nullable && value == -1))
+                throw new InvalidDataException(
+                    $"Level sound-remap {owner} slot {index} references invalid program {value}.");
+            result[index] = new(index, value, new(absoluteOffset + index * sizeof(int), sizeof(int)));
+        }
+        return result;
+    }
+
+    private static short ReadNonNegativeInt16(ReadOnlySpan<byte> bytes, int offset, string name)
+    {
+        var value = ReadInt16LittleEndian(bytes, offset);
+        if (value < 0) throw new InvalidDataException($"Level sound-remap {name} is negative.");
+        return value;
+    }
+
+}
