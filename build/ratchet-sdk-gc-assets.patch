@@ -0,0 +1,55 @@
+using RatchetPs2.Core.Games;
+using RatchetPs2.Core.IO;
+using RatchetPs2.Core.LevelAssets;
+using RatchetPs2.Core.Sounds;
+using RatchetPs2.Core.Wad;
+using RatchetPs2.Core.Wad.Models;
+
+using RatchetPs2.Games.UYA.Level;
+using RatchetPs2.Games.UYA;
+
+namespace RatchetPs2.Games.GC.Level;
+
+internal static class GcLevelAssetExtractor
+{
+    public static LevelAssetExtractionResult Extract(byte[] levelWadBytes)
+    {
+        ArgumentNullException.ThrowIfNull(levelWadBytes);
+        return Extract(UyaLevelWadUnpacker.Unpack(levelWadBytes).Files);
+    }
+
+    public static LevelAssetExtractionResult Extract(IReadOnlyList<PackedFile> unpackedFiles)
+    {
+        var source = UyaLevelWadRenderPackageBuilder.ReadAssetSourceFiles(unpackedFiles);
+        var result = LevelAssetInventoryReader.Extract(source.HeaderBytes, source.PaletteBytes, source.AssetWadBytes);
+        return result with
+        {
+            SoundBanks = ReadSounds(unpackedFiles, source.HeaderBytes, LevelAssetReader.ReadHeader(source.HeaderBytes).SoundRemapOffset),
+        };
+    }
+
+    private static IReadOnlyList<ExtractedLevelSoundBank> ReadSounds(
+        IReadOnlyList<PackedFile> files, byte[] headerBytes, int remapOffset)
+    {
+        var banks = new List<(int Index, string Archive, byte[] Bytes, SoundBankInventory Inventory)>();
+        Add(-1, "level_wad/sound.bnk");
+        for (var index = 0; index < 3; index++) Add(index, $"level_wad/chunks/chunk{index}_bank.wad");
+        if (banks.Count == 0) return [];
+        var secondaryCounts = Enumerable.Range(0, 3)
+            .Select(index => banks.Where(bank => bank.Index == index).Select(bank => bank.Inventory.Programs.Count).DefaultIfEmpty(-1).Single()).ToArray();
+        var remaps = remapOffset == 0 ? [] : LevelSoundRemapReader.Inspect(headerBytes,
+            banks.Where(bank => bank.Index == -1).Select(bank => bank.Inventory.Programs.Count).DefaultIfEmpty(0).Single(),
+            secondaryProgramCounts: secondaryCounts).Mobys;
+        return banks.Select(bank => new ExtractedLevelSoundBank(bank.Bytes, bank.Archive, bank.Inventory,
+            remaps.Where(map => map.BankIndex == bank.Index).Select(map => new ExtractedLevelMobySounds(
+                map.DefinitionIndex, map.ClassId, map.Slots.Select(slot => slot.NativeProgramIndex).ToArray(),
+                "level_wad/assets/asset_wad.bin")).ToArray())).ToArray();
+
+        void Add(int index, string archive)
+        {
+            var bytes = files.SingleOrDefault(file => file.Path == archive)?.Bytes;
+            if (bytes is { Length: > 0 }) banks.Add((index, archive, bytes, Snd989SoundBankReader.Inspect(bytes)));
+        }
+    }
+
+}
diff --git a/src/RatchetPs2.Games.GC/Level/GcLevelAssetModelConverter.cs b/src/RatchetPs2.Games.GC/Level/GcLevelAssetModelConverter.cs
new file mode 100644
index 0000000..9418803
--- /dev/null
+++ b/src/RatchetPs2.Games.GC/Level/GcLevelAssetModelConverter.cs
@@ -0,0 +1,202 @@
+using System.Buffers.Binary;
+using RatchetPs2.Core.Games;
+using RatchetPs2.Core.LevelAssets;
+using RatchetPs2.Core.Moby;
+using RatchetPs2.Core.Shrubs;
+using RatchetPs2.Core.Skyboxes;
+using RatchetPs2.Core.Textures.Palettes;
+using RatchetPs2.Core.Textures.Pif;
+using RatchetPs2.Core.Ties;
+
+namespace RatchetPs2.Games.GC.Level;
+
+internal static class GcLevelAssetModelConverter
+{
+    public static byte[] Convert(FrontendAssetKind kind, byte[] bytes, int targetClassId, CancellationToken cancellationToken = default)
+    {
+        if (kind == FrontendAssetKind.Tie) return ConvertTie(bytes, targetClassId, cancellationToken);
+        using var stream = new MemoryStream(bytes, writable: false);
+        var result = bytes.ToArray();
+        switch (kind)
+        {
+            case FrontendAssetKind.Moby:
+                _ = MobyModelReader.Read(stream);
+                break;
+            case FrontendAssetKind.Shrub:
+                _ = ShrubClassReader.Read(stream);
+                BinaryPrimitives.WriteUInt16LittleEndian(result.AsSpan(0x24), checked((ushort)targetClassId));
+                break;
+            default: throw new ArgumentOutOfRangeException(nameof(kind));
+        }
+        return result;
+    }
+
+    private static byte[] ConvertTie(byte[] bytes, int targetClassId, CancellationToken token, TieAnalysis? analysis = null)
+    {
+        var result = PatchTiePackets(bytes, bytes.ToArray(), analysis ?? new(bytes), token);
+        BinaryPrimitives.WriteUInt16LittleEndian(result.AsSpan(0x44), checked((ushort)targetClassId));
+        _ = TieClassReader.Read(result, TieClassReadOptions.ForGameProfile(TieGameProfile.ForGame(GameId.UYA)));
+        return result;
+    }
+
+    private static byte[] PatchTiePackets(byte[] bytes, byte[] result, TieAnalysis analysis,
+        CancellationToken cancellationToken, GcTiePacketLayout layout = GcTiePacketLayout.Current)
+    {
+        var tie = analysis.Tie;
+        foreach (var block in tie.PacketDataBlocks)
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            var packet = tie.PacketTables[block.LodIndex].Packets[block.PacketIndex];
+            if (packet.ShaderCount is < 1 or > 4)
+                throw new InvalidDataException("GC tie packet shader count must be between one and four.");
+            // UYA locates strip controls after five uploaded rows per shader and four setup rows; GC leaves this word zero.
+            BinaryPrimitives.WriteInt32LittleEndian(result.AsSpan(packet.AbsoluteDataOffset + 0x0c),
+                -(4 + 5 * packet.ShaderCount));
+        }
+        var facingByLod = new Dictionary<int, IReadOnlyList<TieTriangle>>();
+        var partitionFacingByLod = new Dictionary<int, IReadOnlyList<TieTriangle>>();
+        var mixedPackets = new HashSet<(int Lod, int Packet)>();
+        foreach (var topology in tie.LodTopologies.Where(value => value.TriangleCount > 0))
+        {
+            cancellationToken.ThrowIfCancellationRequested();
+            // Keep established boundaries and add splits where corrected facing or odd strips require them.
+            var partitionFacing = analysis.Facing(topology.LodIndex, GcTiePacketLayout.PreviousFacing);
+            var facing = analysis.Facing(topology.LodIndex, layout);
+            facingByLod.Add(topology.LodIndex, facing);
+            partitionFacingByLod.Add(topology.LodIndex, partitionFacing);
+            foreach (var strip in topology.Strips)
+            {
+                cancellationToken.ThrowIfCancellationRequested();
+                var block = analysis.Blocks[(topology.LodIndex, strip.PacketIndex)];
+                var packet = tie.PacketTables[topology.LodIndex].Packets[strip.PacketIndex];
+                if (packet.BfcDistance == 0) continue;
+                var phases = ResolveStripFacing(topology, strip, facing).Where(value => value.HasValue)
+                    .Select(value => value!.Value).Distinct().ToArray();
+                if (layout == GcTiePacketLayout.Current && block.StripControls[strip.PacketStripIndex].TokenCount % 2 != 0
+                    || phases.Length > 1 || ResolveStripFacing(topology, strip, partitionFacing)
+                    .Where(value => value.HasValue).Distinct().Count() > 1)
+                {
+                    mixedPackets.Add((topology.LodIndex, strip.PacketIndex));
+                    continue;
+                }
+                var reverse = phases.FirstOrDefault() ^ ((strip.Flags & 0x20) != 0);
+                var control = block.StripControls[strip.PacketStripIndex];
+                // UYA's culling path compares the sign against strip-control .w bit 0x20; GC leaves it unused.
+                result[control.Offset + 3] = (byte)((control.Flags & ~0x20) | (reverse == true ? 0x20 : 0));
+            }
+        }
+        return mixedPackets.Count == 0 ? result : GcTiePacketRewriter.Rewrite(
+            bytes, result, tie, facingByLod, partitionFacingByLod, mixedPackets, cancellationToken, layout);
+    }
+
+    internal static bool?[] ResolveStripFacing(TieLodTopology topology, TieTriangleStrip strip,
+        IReadOnlyList<TieTriangle> facing)
+    {
+        var phases = new bool?[strip.TriangleCount];
+        for (var offset = 0; offset < strip.TriangleCount; offset++)
+        {
+            var index = strip.TriangleStartIndex + offset;
+            var original = topology.Triangles[index];
+            TiePacketDecodedVertex Vertex(int index) => topology.LogicalVertices[index].DecodedVertex
+                ?? throw new InvalidDataException("GC tie culling requires decoded vertex positions.");
+            var a = Vertex(original.A); var b = Vertex(original.B); var c = Vertex(original.C);
+            var ab = new System.Numerics.Vector3(b.X - a.X, b.Y - a.Y, b.Z - a.Z);
+            var ac = new System.Numerics.Vector3(c.X - a.X, c.Y - a.Y, c.Z - a.Z);
+            if (System.Numerics.Vector3.Cross(ab, ac).LengthSquared() != 0)
+                phases[offset] = facing[index].B == original.C;
+        }
+        return phases;
+    }
+
+    public static byte[]? RepairPreviousStaticConversion(FrontendAssetKind kind, byte[] source,
+        byte[] converted, int previousClassId, int targetClassId, CancellationToken cancellationToken)
+    {
+        var classOffset = kind switch
+        {
+            FrontendAssetKind.Tie => 0x44,
+            FrontendAssetKind.Shrub => 0x24,
+            _ => throw new ArgumentOutOfRangeException(nameof(kind)),
+        };
+        var analysis = kind == FrontendAssetKind.Tie ? new TieAnalysis(source) : null;
+        var corrected = analysis is null ? Convert(kind, source, targetClassId, cancellationToken)
+            : ConvertTie(source, targetClassId, cancellationToken, analysis);
+        if (corrected.AsSpan().SequenceEqual(converted)) return corrected;
+        if (!MatchesClass(source, converted, classOffset, previousClassId)
+            && !MatchesClass(corrected, converted, classOffset, previousClassId))
+        {
+            if (kind != FrontendAssetKind.Tie) return null;
+            // Recognize the earlier split conversion exactly, without replacing independently edited models.
+            var recognized = false;
+            foreach (var previousLayout in new[] { GcTiePacketLayout.OriginalSplit, GcTiePacketLayout.MissingFatPhase, GcTiePacketLayout.PreviousFacing, GcTiePacketLayout.CoincidentFacing, GcTiePacketLayout.UnpaddedStrips })
+            {
+                var split = PatchTiePackets(source, source.ToArray(), analysis!, cancellationToken, previousLayout);
+                if (MatchesClass(split, converted, classOffset, previousClassId)) { recognized = true; break; }
+            }
+            if (!recognized) return null;
+        }
+        return corrected;
+    }
+
+    private static bool MatchesClass(byte[] candidate, byte[] converted, int offset, int classId) =>
+        candidate.Length == converted.Length
+        && BinaryPrimitives.ReadUInt16LittleEndian(converted.AsSpan(offset)) == classId
+        && candidate.AsSpan(0, offset).SequenceEqual(converted.AsSpan(0, offset))
+        && candidate.AsSpan(offset + 2).SequenceEqual(converted.AsSpan(offset + 2));
+
+    // A repair may try several historical writers; parse and resolve each facing policy only once.
+    private sealed class TieAnalysis
+    {
+        private static readonly TieGameProfile Profile = TieGameProfile.ForGame(GameId.GC);
+        private readonly Dictionary<(int Lod, GcTiePacketLayout Facing), IReadOnlyList<TieTriangle>> _facing = [];
+        public TieClass Tie { get; }
+        public IReadOnlyDictionary<(int Lod, int Packet), TiePacketDataBlock> Blocks { get; }
+
+        public TieAnalysis(byte[] source)
+        {
+            Tie = TieClassReader.Read(source, TieClassReadOptions.ForGameProfile(Profile));
+            Blocks = Tie.PacketDataBlocks.ToDictionary(block => (block.LodIndex, block.PacketIndex));
+        }
+
+        public IReadOnlyList<TieTriangle> Facing(int lod, GcTiePacketLayout layout)
+        {
+            var policy = layout switch
+            {
+                GcTiePacketLayout.Current or GcTiePacketLayout.UnpaddedStrips => GcTiePacketLayout.Current,
+                GcTiePacketLayout.CoincidentFacing => GcTiePacketLayout.CoincidentFacing,
+                _ => GcTiePacketLayout.PreviousFacing,
+            };
+            var key = (lod, policy);
+            if (_facing.TryGetValue(key, out var value)) return value;
+            value = TieGltfExporter.ResolveTriangleFacing(Tie, lod, Profile,
+                includeCoincidentAdjacency: policy == GcTiePacketLayout.PreviousFacing,
+                includeOverlappingAdjacency: policy == GcTiePacketLayout.CoincidentFacing);
+            _facing.Add(key, value);
+            return value;
+        }
+    }
+
+    public static byte[] ConvertTexture(byte[] bytes, TextureRole role)
+    {
+        var source = PifReader.Read(bytes);
+        if (source.Encoding != PifTextureEncoding.Indexed8 || source.IsSwizzled)
+            throw new InvalidDataException("GC to UYA conversion requires linear indexed8 textures.");
+        var limit = role switch
+        {
+            TextureRole.Material => 2,
+            TextureRole.Billboard => 3,
+            _ => throw new ArgumentOutOfRangeException(nameof(role)),
+        };
+        return PifWriter.Write(new(source.Header, source.Encoding, source.PaletteData, source.PixelData,
+            source.MipPixelData.Take(limit).ToArray()));
+    }
+
+    public static byte[] ConvertSky(byte[] bytes, CancellationToken cancellationToken)
+    {
+        cancellationToken.ThrowIfCancellationRequested();
+        using var stream = new MemoryStream(bytes, writable: false);
+        _ = SkyboxReader.Read(stream, GameId.GC);
+        stream.Position = 0;
+        _ = SkyboxReader.Read(stream, GameId.UYA);
+        return bytes.ToArray();
+    }
+}
diff --git a/src/RatchetPs2.Games.GC/Level/GcTieColorRemapWriter.cs b/src/RatchetPs2.Games.GC/Level/GcTieColorRemapWriter.cs
new file mode 100644
index 0000000..b2f6063
--- /dev/null
+++ b/src/RatchetPs2.Games.GC/Level/GcTieColorRemapWriter.cs
@@ -0,0 +1,114 @@
+using System.Buffers.Binary;
+using RatchetPs2.Core.Ties;
+
+namespace RatchetPs2.Games.GC.Level;
+
+internal static class GcTieColorRemapWriter
+{
+    public static byte[] Write(byte[] source, TieClass tie, int lod, IReadOnlyList<GcTieRebuiltPacket> packets)
+    {
+        var recipes = tie.RgbaRemapOperations.Where(operation => operation.LodIndex == lod)
+            .GroupBy(operation => operation.TargetCacheSlot).ToDictionary(group => group.Key,
+                group => group.OrderBy(operation => operation.Offset).Last());
+        var groups = new List<byte[]>();
+        var colors = new List<int>();
+        foreach (var packet in packets)
+        {
+            if (colors.Count > 0 && (colors.Count + packet.SourceColorSlots.Length > 256
+                || GroupSize(colors.Concat(packet.SourceColorSlots), recipes) > 0x400)) Flush();
+            colors.AddRange(packet.SourceColorSlots);
+            if (colors.Count > 256 || GroupSize(colors, recipes) > 0x400)
+                throw new InvalidDataException("GC tie color packet exceeds the UYA lighting scratch buffer.");
+        }
+        if (colors.Count > 0) Flush();
+        if (groups.Count > 31) throw new InvalidDataException("GC tie needs more than 31 lighting remap groups.");
+        var bytes = new byte[32 + groups.Sum(group => group.Length)];
+        var offset = 32;
+        for (var index = 0; index < groups.Count; index++)
+        {
+            bytes[index] = checked((byte)(groups[index].Length / 16));
+            groups[index].CopyTo(bytes, offset);
+            offset += groups[index].Length;
+        }
+        return bytes;
+
+        void Flush()
+        {
+            var group = new byte[GroupSize(colors, recipes)];
+            var cursor = 16;
+            for (var kind = 0; kind < 6; kind++)
+            {
+                var start = cursor;
+                for (var index = 0; index < colors.Count; index++)
+                {
+                    var color = colors[index];
+                    if (color < 0)
+                    {
+                        if (kind != 5) continue;
+                        BinaryPrimitives.WriteUInt16LittleEndian(group.AsSpan(cursor), checked((ushort)(index * 4)));
+                        cursor += 2;
+                        continue;
+                    }
+                    if (!recipes.TryGetValue(color, out var recipe))
+                        throw new InvalidDataException($"GC LOD {lod} color slot {color} has no lighting recipe.");
+                    if ((int)recipe.Kind != kind) continue;
+                    var size = RecordSize(recipe.Kind);
+                    source.AsSpan(recipe.Offset, size).CopyTo(group.AsSpan(cursor));
+                    if (recipe.Kind is TieRgbaRemapOperationKind.Average2 or TieRgbaRemapOperationKind.WeightedAverage3To1)
+                    {
+                        var packed = BinaryPrimitives.ReadUInt32LittleEndian(group.AsSpan(cursor));
+                        BinaryPrimitives.WriteUInt32LittleEndian(group.AsSpan(cursor), (packed & ~0x3ffcu) | (uint)(index * 4));
+                    }
+                    else
+                    {
+                        var target = BinaryPrimitives.ReadUInt16LittleEndian(group.AsSpan(cursor + size - 2));
+                        BinaryPrimitives.WriteUInt16LittleEndian(group.AsSpan(cursor + size - 2),
+                            checked((ushort)((target & ~0x3ffc) | index * 4)));
+                    }
+                    cursor += size;
+                }
+                BinaryPrimitives.WriteUInt16LittleEndian(group.AsSpan(kind * 2), checked((ushort)(cursor - start)));
+            }
+            BinaryPrimitives.WriteUInt16LittleEndian(group.AsSpan(12), checked((ushort)(colors.Count / 4)));
+            BinaryPrimitives.WriteUInt16LittleEndian(group.AsSpan(14), checked((ushort)group.Length));
+            groups.Add(group);
+            colors.Clear();
+        }
+    }
+
+    public static byte[]? WriteGlowTargets(byte[] source, TieClass tie, int lod, IReadOnlyList<GcTieRebuiltPacket> packets)
+    {
+        var relative = tie.Header.UnknownOffsets78[lod];
+        if (relative == 0) return null;
+        var offset = checked((int)tie.Header.VertexNormalsOffset + relative);
+        var count = BinaryPrimitives.ReadUInt16LittleEndian(source.AsSpan(offset));
+        var oldTargets = new HashSet<int>();
+        for (var index = 0; index < count; index++)
+        {
+            var target = BinaryPrimitives.ReadUInt16LittleEndian(source.AsSpan(offset + 2 + index * 2));
+            if (target % 4 != 0) throw new InvalidDataException("GC glow-cache target is not word aligned.");
+            oldTargets.Add(target / 4);
+        }
+        var targets = packets.SelectMany(packet => packet.SourceColorSlots)
+            .Select((old, index) => (old, index)).Where(value => oldTargets.Contains(value.old)).ToArray();
+        var bytes = new byte[Align16(2 + targets.Length * 2)];
+        BinaryPrimitives.WriteUInt16LittleEndian(bytes, checked((ushort)targets.Length));
+        for (var index = 0; index < targets.Length; index++)
+            BinaryPrimitives.WriteUInt16LittleEndian(bytes.AsSpan(2 + index * 2), checked((ushort)(targets[index].index * 4)));
+        return bytes;
+    }
+
+    private static int GroupSize(IEnumerable<int> colors, IReadOnlyDictionary<int, TieRgbaRemapOperation> recipes) =>
+        Align16(16 + colors.Sum(color => color < 0 ? 2 : recipes.TryGetValue(color, out var recipe)
+            ? RecordSize(recipe.Kind) : throw new InvalidDataException($"GC color slot {color} has no lighting recipe.")));
+
+    private static int RecordSize(TieRgbaRemapOperationKind kind) => kind switch
+    {
+        TieRgbaRemapOperationKind.DirectCopy or TieRgbaRemapOperationKind.Average2
+            or TieRgbaRemapOperationKind.WeightedAverage3To1 => 4,
+        TieRgbaRemapOperationKind.WeightedAverage2To1To1 or TieRgbaRemapOperationKind.Average4 => 8,
+        _ => throw new ArgumentOutOfRangeException(nameof(kind)),
+    };
+
+    private static int Align16(int value) => checked((value + 15) & ~15);
+}
diff --git a/src/RatchetPs2.Games.GC/Level/GcTiePacketRewriter.cs b/src/RatchetPs2.Games.GC/Level/GcTiePacketRewriter.cs
new file mode 100644
index 0000000..5e2ef65
--- /dev/null
+++ b/src/RatchetPs2.Games.GC/Level/GcTiePacketRewriter.cs
@@ -0,0 +1,160 @@
+using System.Buffers.Binary;
+using RatchetPs2.Core.Gltf;
+using RatchetPs2.Core.Ties;
+
+namespace RatchetPs2.Games.GC.Level;
+
+internal static class GcTiePacketRewriter
+{
+    public static byte[] Rewrite(byte[] source, byte[] patched, TieClass tie,
+        IReadOnlyDictionary<int, IReadOnlyList<TieTriangle>> facing,
+        IReadOnlyDictionary<int, IReadOnlyList<TieTriangle>> partitionFacing,
+        IReadOnlySet<(int Lod, int Packet)> mixedPackets, CancellationToken token, GcTiePacketLayout layout = GcTiePacketLayout.Current)
+    {
+        if (tie.Header.AmbientRgbaOffset != 0)
+            throw new NotSupportedException("GC tie splitting cannot relocate an inline ambient-color buffer.");
+        var packets = new List<GcTieRebuiltPacket>[3];
+        for (var lod = 0; lod < 3; lod++)
+        {
+            packets[lod] = [];
+            var colorBase = 0;
+            var topology = tie.LodTopologies[lod];
+            foreach (var packet in tie.PacketTables[lod].Packets)
+            {
+                token.ThrowIfCancellationRequested();
+                var block = tie.PacketDataBlocks.Single(value => value.LodIndex == lod && value.PacketIndex == packet.PacketIndex);
+                var strips = topology.Strips.Where(value => value.PacketIndex == packet.PacketIndex).ToArray();
+                if (!mixedPackets.Contains((lod, packet.PacketIndex)))
+                {
+                    var colors = new int[(packet.RgbaCount + 3) & ~3];
+                    Array.Fill(colors, -1);
+                    for (var index = 0; index < packet.RgbaCount; index++) colors[index] = colorBase + index;
+                    packets[lod].Add(new(source.AsSpan(checked((int)tie.PacketTables[lod].Offset) + packet.PacketIndex * 16, 16).ToArray(),
+                        patched.AsSpan(block.Offset, block.Length).ToArray(), colors,
+                        strips.Sum(strip => strip.LogicalVertexCount), strips.Sum(strip => strip.TriangleCount), strips.Length));
+                }
+                else
+                {
+                    if (block.DecodedVertices.Count != packet.RgbaCount)
+                        throw new InvalidDataException("GC tie upload vertices do not match its color-cache span.");
+                    var runs = strips.SelectMany(strip => Split(topology, strip,
+                        block.StripControls[strip.PacketStripIndex], facing[lod], partitionFacing[lod])).ToArray();
+                    packets[lod].AddRange(GcTiePacketWriter.Build(source, packet, block, colorBase, runs, layout));
+                }
+                colorBase += (packet.RgbaCount + 3) & ~3;
+            }
+            // UYA NTSC-U reads this with LBU (004c9794) and compares the 16-byte table end (004c98ac).
+            if (packets[lod].Count > byte.MaxValue)
+                throw new InvalidDataException($"GC tie LOD {lod} needs {packets[lod].Count} UYA packets, over the 255-packet limit.");
+        }
+        using var output = new MemoryStream();
+        var prefix = checked((int)tie.PacketTables.Where(table => table.Count > 0).Min(table => table.Offset));
+        if (prefix < 0x80) throw new InvalidDataException("GC tie packet table overlaps its header.");
+        output.Write(source.AsSpan(0, prefix));
+        var tables = new int[3];
+        for (var lod = 0; lod < 3; lod++)
+        {
+            tables[lod] = checked((int)output.Position);
+            output.Write(new byte[packets[lod].Count * 16]);
+        }
+        var dataOffsets = new List<int>[3];
+        for (var lod = 0; lod < 3; lod++)
+        {
+            dataOffsets[lod] = [];
+            foreach (var packet in packets[lod])
+            {
+                token.ThrowIfCancellationRequested();
+                dataOffsets[lod].Add(checked((int)output.Position));
+                output.Write(packet.Bytes);
+            }
+        }
+        var normalsOffset = checked((int)output.Position);
+        output.Write(source.AsSpan(checked((int)tie.Header.VertexNormalsOffset), tie.Header.VertexNormalsCount * 8));
+        Align(output);
+        var remaps = new int[3];
+        for (var lod = 0; lod < 3; lod++)
+        {
+            token.ThrowIfCancellationRequested();
+            if (packets[lod].Count == 0) continue;
+            remaps[lod] = checked((int)output.Position - normalsOffset);
+            output.Write(GcTieColorRemapWriter.Write(source, tie, lod, packets[lod]));
+        }
+        var glow = new int[3];
+        for (var lod = 0; lod < 3; lod++)
+        {
+            var bytes = GcTieColorRemapWriter.WriteGlowTargets(source, tie, lod, packets[lod]);
+            if (bytes is null) continue;
+            glow[lod] = checked((int)output.Position - normalsOffset);
+            output.Write(bytes);
+        }
+        var shadersOffset = checked((int)output.Position);
+        output.Write(source.AsSpan(checked((int)tie.Header.ShadersOffset)));
+        if (output.Length > StaticModelNativeLimits.MaximumModelBytes)
+            throw new InvalidDataException("GC tie conversion exceeds the UYA model size limit.");
+        var result = output.ToArray();
+        BinaryPrimitives.WriteInt32LittleEndian(result.AsSpan(0x34), normalsOffset);
+        BinaryPrimitives.WriteInt32LittleEndian(result.AsSpan(0x1c), shadersOffset);
+        for (var lod = 0; lod < 3; lod++)
+        {
+            BinaryPrimitives.WriteInt32LittleEndian(result.AsSpan(lod * 4), tables[lod]);
+            result[12 + lod] = checked((byte)packets[lod].Count);
+            BinaryPrimitives.WriteInt16LittleEndian(result.AsSpan(0x24 + lod * 2),
+                checked((short)(packets[lod].Sum(packet => packet.SourceColorSlots.Length) / 4)));
+            BinaryPrimitives.WriteUInt16LittleEndian(result.AsSpan(0x2a + lod * 2), checked((ushort)remaps[lod]));
+            BinaryPrimitives.WriteUInt16LittleEndian(result.AsSpan(0x78 + lod * 2), checked((ushort)glow[lod]));
+            BinaryPrimitives.WriteInt16LittleEndian(result.AsSpan(0x60 + lod * 8),
+                checked((short)packets[lod].Sum(packet => packet.LogicalVertices)));
+            BinaryPrimitives.WriteInt16LittleEndian(result.AsSpan(0x62 + lod * 8),
+                checked((short)packets[lod].Sum(packet => packet.Triangles)));
+            BinaryPrimitives.WriteInt16LittleEndian(result.AsSpan(0x64 + lod * 8),
+                checked((short)packets[lod].Sum(packet => packet.Strips)));
+            for (var index = 0; index < packets[lod].Count; index++)
+            {
+                var record = packets[lod][index].Record;
+                BinaryPrimitives.WriteInt32LittleEndian(record, dataOffsets[lod][index] - tables[lod]);
+                record.CopyTo(result, tables[lod] + index * 16);
+            }
+        }
+        return result;
+    }
+
+    private static IEnumerable<GcTieStripRun> Split(TieLodTopology topology, TieTriangleStrip strip,
+        TiePacketStripControl control, IReadOnlyList<TieTriangle> facing, IReadOnlyList<TieTriangle> partitionFacing)
+    {
+        var phases = GcLevelAssetModelConverter.ResolveStripFacing(topology, strip, facing);
+        var partitions = GcLevelAssetModelConverter.ResolveStripFacing(topology, strip, partitionFacing);
+        FillDegeneratePhases(phases);
+        FillDegeneratePhases(partitions);
+        var start = 0;
+        while (start < phases.Length)
+        {
+            var end = start + 1;
+            while (end < phases.Length && phases[end] == phases[start]
+                && partitions[end] == partitions[start] && end - start < 62) end++;
+            var vertices = strip.LogicalVertices.Skip(start).Take(end - start + 2).ToList();
+            // UYA's culling loop consumes two triangles per iteration, including degenerate padding.
+            if (vertices.Count % 2 != 0) vertices.Add(vertices[^1]);
+            var reverse = ((strip.Flags & 0x20) != 0) ^ phases[start]!.Value ^ ((start & 1) != 0);
+            yield return new(vertices.ToArray(), strip.ShaderIndex
+                ?? throw new InvalidDataException("GC strip has no resolved shader."),
+                (byte)((strip.Flags & ~0x20) | (reverse ? 0x20 : 0)), control.ControlData1);
+            start = end;
+        }
+    }
+
+    private static void FillDegeneratePhases(bool?[] phases)
+    {
+        var current = phases.FirstOrDefault(value => value.HasValue) ?? false;
+        for (var index = 0; index < phases.Length; index++)
+        {
+            if (phases[index] is { } phase) current = phase;
+            else phases[index] = current;
+        }
+    }
+
+    private static void Align(MemoryStream stream)
+    {
+        var size = checked((int)((16 - stream.Position % 16) % 16));
+        stream.Write(new byte[size]);
+    }
+}
diff --git a/src/RatchetPs2.Games.GC/Level/GcTiePacketWriter.cs b/src/RatchetPs2.Games.GC/Level/GcTiePacketWriter.cs
new file mode 100644
index 0000000..6f69893
--- /dev/null
+++ b/src/RatchetPs2.Games.GC/Level/GcTiePacketWriter.cs
@@ -0,0 +1,227 @@
+using System.Buffers.Binary;
+using RatchetPs2.Core.Ties;
+
+namespace RatchetPs2.Games.GC.Level;
+
+internal sealed record GcTieStripRun(TieLogicalVertex[] Vertices, int Shader, byte Flags, byte ControlData1);
+internal sealed record GcTieRebuiltPacket(byte[] Record, byte[] Bytes, int[] SourceColorSlots,
+    int LogicalVertices, int Triangles, int Strips);
+
+internal enum GcTiePacketLayout { Current, OriginalSplit, MissingFatPhase, PreviousFacing, CoincidentFacing, UnpaddedStrips }
+
+internal static class GcTiePacketWriter
+{
+    public static IEnumerable<GcTieRebuiltPacket> Build(byte[] source, TiePacket packet,
+        TiePacketDataBlock block, int colorBase, IReadOnlyList<GcTieStripRun> runs, GcTiePacketLayout layout = GcTiePacketLayout.Current)
+    {
+        var batch = new List<GcTieStripRun>();
+        foreach (var run in runs)
+        {
+            if (batch.Count > 0 && !Fits(batch.Append(run)))
+            {
+                yield return Write(source, packet, block, colorBase, batch, layout);
+                batch.Clear();
+            }
+            batch.Add(run);
+            if (!Fits(batch)) throw new InvalidDataException("GC tie strip exceeds UYA packet limits.");
+        }
+        if (batch.Count > 0) yield return Write(source, packet, block, colorBase, batch, layout);
+    }
+
+    private static bool Fits(IEnumerable<GcTieStripRun> runs)
+    {
+        var end = 6;
+        var shaders = 0;
+        var strips = 0;
+        var previousShader = -1;
+        foreach (var run in runs)
+        {
+            if (run.Shader != previousShader)
+            {
+                if (shaders++ > 0) end += 6;
+                previousShader = run.Shader;
+            }
+            end += 1 + run.Vertices.Length * 3;
+            strips++;
+        }
+        return end <= 0xcc && shaders <= 4 && strips <= 15;
+    }
+
+    private static GcTieRebuiltPacket Write(byte[] source, TiePacket original, TiePacketDataBlock block,
+        int colorBase, IReadOnlyList<GcTieStripRun> runs, GcTiePacketLayout layout)
+    {
+        var uploads = new List<VertexUpload>();
+        var available = new Dictionary<int, int>();
+        var drawCount = 0;
+        foreach (var vertex in runs.SelectMany(run => run.Vertices))
+        {
+            var sourceIndex = vertex.DecodedVertex!.Index;
+            if (original.MultipassOffset == 0 && available.Remove(sourceIndex, out var previous))
+                uploads[previous] = uploads[previous] with { Secondary = drawCount };
+            else
+            {
+                available[sourceIndex] = uploads.Count;
+                uploads.Add(new(vertex.DecodedVertex!, drawCount, null));
+            }
+            drawCount++;
+        }
+        // Reproduce the old layout only when recognizing an earlier conversion for migration.
+        var vertices = layout == GcTiePacketLayout.OriginalSplit ? uploads.OrderBy(value => value.Vertex.Kind).ToArray()
+            : PrepareUploads(uploads, block, layout).ToArray();
+        var count = vertices.Length;
+        var dinky = vertices.Count(value => value.Vertex.Kind == TiePacketDecodedVertexKind.Dinky);
+        var fat = count - dinky;
+        var controlCount = 3 + runs.Count;
+        var controlSize = (controlCount + 3) / 4;
+        var vertexOffset = 2 + controlSize;
+        var vertexSize = (dinky * 16 + fat * 24 + 15) / 16;
+        var scissorOffset = vertexOffset + vertexSize;
+        var scissorSize = (drawCount + 1 + 15) / 16;
+        var multipassOffset = original.MultipassOffset > 0 ? scissorOffset + scissorSize : 0;
+        var multipassSize = multipassOffset > 0 ? (drawCount + 3) / 4 : 0;
+        if (multipassOffset > 0 && (original.PassFlags != 1 || original.MultipassUvSize * 4 <
+            block.StripControls.Sum(strip => strip.TokenCount)))
+            throw new NotSupportedException("GC tie strip splitting requires a complete texture-matrix UV stream.");
+        var bytes = new byte[(multipassOffset > 0 ? multipassOffset + 3 + multipassSize : scissorOffset + scissorSize) * 16];
+        var record = new byte[16];
+        record[5] = original.BfcDistance;
+        record[6] = checked((byte)controlCount);
+        record[7] = checked((byte)controlSize);
+        record[8] = checked((byte)vertexOffset);
+        record[9] = checked((byte)vertexSize);
+        record[10] = checked((byte)count);
+        record[11] = checked((byte)multipassOffset);
+        record[12] = checked((byte)scissorOffset);
+        record[13] = checked((byte)scissorSize);
+        record[14] = original.PassFlags;
+        record[15] = checked((byte)multipassSize);
+        source.AsSpan(original.AbsoluteDataOffset + 0x20, 12).CopyTo(bytes.AsSpan(0x20));
+        bytes[0x23] = checked((byte)runs.Count);
+        bytes[0x28] = checked((byte)(4 + 2 * dinky));
+        bytes[0x29] = checked((byte)(6 + 3 * fat));
+        bytes[0x2a] = checked((byte)dinky);
+        bytes[0x2b] = checked((byte)fat);
+        var destinations = new int[drawCount];
+        var cursor = 6;
+        var logical = 0;
+        var shaders = 0;
+        var previousShader = -1;
+        for (var index = 0; index < runs.Count; index++)
+        {
+            var run = runs[index];
+            var shaderSwitch = previousShader >= 0 && previousShader != run.Shader;
+            if (run.Shader != previousShader)
+            {
+                if (shaders > 0)
+                {
+                    BinaryPrimitives.WriteInt32LittleEndian(bytes.AsSpan((shaders - 1) * 4), cursor);
+                    cursor += 6;
+                }
+                BinaryPrimitives.WriteInt32LittleEndian(bytes.AsSpan(0x10 + shaders * 4), run.Shader * 0x50);
+                shaders++;
+                previousShader = run.Shader;
+            }
+            var control = 0x2c + index * 4;
+            bytes[control] = checked((byte)run.Vertices.Length);
+            bytes[control + 1] = run.ControlData1;
+            bytes[control + 2] = checked((byte)cursor);
+            bytes[control + 3] = run.Flags;
+            for (var vertex = 0; vertex < run.Vertices.Length; vertex++, logical++)
+            {
+                destinations[logical] = cursor + 1 + vertex * 3;
+                bytes[scissorOffset * 16 + logical] = vertex > 0 ? (byte)3
+                    : index == 0 ? (byte)7 : shaderSwitch ? (byte)0xf6 : (byte)0xfc;
+            }
+            cursor += 1 + run.Vertices.Length * 3;
+        }
+        bytes[scissorOffset * 16 + drawCount] = 0xf6;
+        record[4] = checked((byte)shaders);
+        BinaryPrimitives.WriteInt32LittleEndian(bytes.AsSpan(12), -(4 + shaders * 5));
+        if (layout != GcTiePacketLayout.OriginalSplit)
+        {
+            for (var kind = 0; kind < 2; kind++)
+            {
+                var group = vertices.Where(value => (value.Vertex.Kind == TiePacketDecodedVertexKind.Dinky ? 0 : 1) == kind);
+                var singles = group.Where(value => value.Secondary is null).ToArray();
+                var shared = group.Where(value => value.Secondary is not null).ToArray();
+                // The second flag skips the entire fat phase, including single writes.
+                var skip = kind == 0 || layout == GcTiePacketLayout.MissingFatPhase
+                    ? shared.Length == 0 : fat == 0;
+                bytes[0x20 + kind] = skip ? (byte)1 : (byte)0;
+                bytes[0x24 + kind * 2] = singles.Length == 0 ? (byte)0
+                    : checked((byte)destinations[singles[^(kind == 0 ? 4 : 1)].Primary]);
+                bytes[0x25 + kind * 2] = shared.Length == 0 ? (byte)0
+                    : checked((byte)destinations[shared[^(kind == 0 ? 3 : 1)].Primary]);
+            }
+        }
+        var colors = new int[(count + 3) & ~3];
+        Array.Fill(colors, -1);
+        var vertexCursor = vertexOffset * 16;
+        for (var index = 0; index < vertices.Length; index++)
+        {
+            var upload = vertices[index];
+            var vertex = upload.Vertex;
+            vertex.Bytes.CopyTo(bytes, vertexCursor);
+            BinaryPrimitives.WriteUInt16LittleEndian(bytes.AsSpan(vertexCursor + 6), checked((ushort)destinations[upload.Primary]));
+            BinaryPrimitives.WriteUInt16LittleEndian(bytes.AsSpan(vertexCursor + vertex.Bytes.Length - 2),
+                upload.Secondary is { } secondary ? checked((ushort)destinations[secondary]) : (ushort)0);
+            colors[index] = colorBase + vertex.Index;
+            vertexCursor += vertex.Bytes.Length;
+        }
+        if (multipassOffset > 0)
+        {
+            source.AsSpan(original.AbsoluteDataOffset + original.MultipassOffset * 16, 48)
+                .CopyTo(bytes.AsSpan(multipassOffset * 16));
+            BinaryPrimitives.WriteInt32LittleEndian(bytes.AsSpan(multipassOffset * 16 + 32), drawCount);
+            // UV1 words follow physical strip order, independently of dinky/fat upload order.
+            var stripStarts = block.StripControls.Select(strip => strip.TokenCount).ToArray();
+            var uv = multipassOffset * 16 + 48;
+            foreach (var vertex in runs.SelectMany(run => run.Vertices))
+            {
+                var oldIndex = stripStarts.Take(vertex.PacketStripIndex).Sum(value => value) + vertex.IndexInStrip;
+                source.AsSpan(original.AbsoluteDataOffset + original.MultipassOffset * 16 + 48 + oldIndex * 4, 4)
+                    .CopyTo(bytes.AsSpan(uv));
+                uv += 4;
+            }
+        }
+        return new(record, bytes, colors, drawCount, drawCount - runs.Count * 2, runs.Count);
+    }
+
+    private static IEnumerable<VertexUpload> PrepareUploads(List<VertexUpload> uploads, TiePacketDataBlock block, GcTiePacketLayout layout)
+    {
+        if (uploads.All(value => value.Vertex.Kind != TiePacketDecodedVertexKind.Dinky))
+        {
+            // Fat-only batches still need the four prefetched dinky vertices; real fat writes replace these placeholders.
+            var padding = block.DecodedVertices.First(value => value.Kind == TiePacketDecodedVertexKind.Dinky);
+            uploads.Insert(0, new(padding, uploads[0].Primary, null));
+        }
+        foreach (var group in uploads.GroupBy(value => value.Vertex.Kind).OrderBy(group => group.Key))
+        {
+            var singles = group.Where(value => value.Secondary is null).ToList();
+            var shared = group.Where(value => value.Secondary is not null).ToList();
+            var dinky = group.Key == TiePacketDecodedVertexKind.Dinky;
+            var minimum = dinky ? 4 : 1;
+            while (shared.Count > 0 && (singles.Count < minimum || dinky && shared.Count < 3))
+            {
+                var vertex = shared[^1];
+                shared.RemoveAt(shared.Count - 1);
+                singles.Add(vertex with { Secondary = null });
+                singles.Add(vertex with { Primary = vertex.Secondary!.Value, Secondary = null });
+            }
+            if (layout != GcTiePacketLayout.MissingFatPhase && !dinky && shared.Count == 0)
+            {
+                // UYA always runs both fat phases; a self-write supplies the shared phase for an unshared tail.
+                var last = singles[^1];
+                if (singles.Count > 1) singles.RemoveAt(singles.Count - 1);
+                shared.Add(last with { Secondary = last.Primary });
+            }
+            // The dinky pipeline preloads four vertices; repeat a real write to drain a short group safely.
+            while (singles.Count < minimum) singles.Add(singles[^1]);
+            foreach (var vertex in singles) yield return vertex;
+            foreach (var vertex in shared) yield return vertex;
+        }
+    }
+
+    private sealed record VertexUpload(TiePacketDecodedVertex Vertex, int Primary, int? Secondary);
+
+}
diff --git a/tests/RatchetPs2.LevelTests/GcTieConversionAssertions.cs b/tests/RatchetPs2.LevelTests/GcTieConversionAssertions.cs
new file mode 100644
index 0000000..279b3da
--- /dev/null
+++ b/tests/RatchetPs2.LevelTests/GcTieConversionAssertions.cs
@@ -0,0 +1,143 @@
+using System.Buffers.Binary;
+using RatchetPs2.Core.Games;
+using RatchetPs2.Core.Ties;
+
+internal static class GcTieConversionAssertions
+{
+    public static void Equivalent(byte[] sourceBytes, byte[] convertedBytes)
+    {
+        var source = Read(sourceBytes, GameId.GC);
+        var converted = Read(convertedBytes, GameId.UYA);
+        Expect(source.Header.OClass == converted.Header.OClass, "source class retained");
+        Expect(source.Header.Scale == converted.Header.Scale, "quantization scale retained");
+        Expect(source.Header.VertexNormalsCount == converted.Header.VertexNormalsCount
+            && sourceBytes.AsSpan((int)source.Header.VertexNormalsOffset, source.Header.VertexNormalsCount * 8)
+                .SequenceEqual(convertedBytes.AsSpan((int)converted.Header.VertexNormalsOffset, converted.Header.VertexNormalsCount * 8)),
+            "normal palette is byte-identical");
+        Expect(source.Header.TextureCount == converted.Header.TextureCount
+            && sourceBytes.AsSpan((int)source.Header.ShadersOffset, source.Header.TextureCount * 0x50)
+                .SequenceEqual(convertedBytes.AsSpan((int)converted.Header.ShadersOffset, converted.Header.TextureCount * 0x50)),
+            "shaders and texture bindings are byte-identical");
+        for (var lod = 0; lod < 3; lod++)
+        {
+            var wanted = Faces(sourceBytes, source, lod, resolveFacing: true);
+            var actual = Faces(convertedBytes, converted, lod, resolveFacing: false);
+            Expect(wanted.SequenceEqual(actual),
+                $"LOD {lod} preserves face order, oriented geometry, vertex attributes, lighting recipes, glow targets, BFC distances and UV passes"
+                + $" (faces {wanted.Count}/{actual.Count})");
+            Expect(converted.PacketTables[lod].Packets.Count <= byte.MaxValue, "unsigned packet count stays within UYA limits");
+            Expect(converted.Header.CacheSizes[lod] == converted.PacketTables[lod].Packets.Sum(packet => (packet.RgbaCount + 3) / 4),
+                "lighting cache fits every packet upload");
+            if (converted.PacketTables[lod].Count == 0) continue;
+            var remap = (int)converted.Header.VertexNormalsOffset + converted.Header.RgbaRemapOffsets[lod];
+            Expect(convertedBytes[remap + 31] == 0, "lighting remap group table has its runtime terminator");
+        }
+        foreach (var block in converted.PacketDataBlocks)
+        {
+            GcTieVuUploadAssertions.Validate(block);
+            var packet = converted.PacketTables[block.LodIndex].Packets[block.PacketIndex];
+            Expect(BinaryPrimitives.ReadInt32LittleEndian(block.Bytes.AsSpan(12)) == -(4 + 5 * packet.ShaderCount),
+                "VU culling setup locates the strip controls");
+            Expect(packet.RgbaCount == block.DecodedVertices.Count, "dinky/fat counts fit the RGBA upload");
+            Expect(block.StripControls.All(strip => strip.TokenCount % 2 == 0
+                && strip.VuAddress + 1 + strip.TokenCount * 3 <= 0xcc), "VU paired loops terminate inside the GS output buffer");
+        }
+    }
+
+    private static List<string> Faces(byte[] bytes, TieClass tie, int lod, bool resolveFacing)
+    {
+        var topology = tie.LodTopologies[lod];
+        var faces = new List<string>();
+        if (topology.TriangleCount == 0) return faces;
+        var triangles = resolveFacing
+            ? TieGltfExporter.ResolveTriangleFacing(tie, lod, TieGameProfile.ForGame(GameId.GC)) : topology.Triangles;
+        var bases = new Dictionary<int, int>();
+        var colorBase = 0;
+        foreach (var packet in tie.PacketTables[lod].Packets)
+        {
+            bases[packet.PacketIndex] = colorBase;
+            colorBase += (packet.RgbaCount + 3) & ~3;
+        }
+        var recipes = tie.RgbaRemapOperations.Where(value => value.LodIndex == lod).GroupBy(value => value.TargetCacheSlot)
+            .ToDictionary(group => group.Key, group => Recipe(bytes, group.OrderBy(value => value.Offset).Last()));
+        var glow = new HashSet<int>();
+        if (tie.Header.UnknownOffsets78[lod] != 0)
+        {
+            var offset = (int)tie.Header.VertexNormalsOffset + tie.Header.UnknownOffsets78[lod];
+            var count = BinaryPrimitives.ReadUInt16LittleEndian(bytes.AsSpan(offset));
+            for (var index = 0; index < count; index++)
+                glow.Add(BinaryPrimitives.ReadUInt16LittleEndian(bytes.AsSpan(offset + 2 + index * 2)) / 4);
+        }
+        var vertexKeys = new string[topology.LogicalVertexCount];
+        foreach (var strip in topology.Strips)
+        {
+            var packet = tie.PacketTables[lod].Packets[strip.PacketIndex];
+            var block = tie.PacketDataBlocks.Single(value => value.LodIndex == lod && value.PacketIndex == strip.PacketIndex);
+            var uvHeader = "";
+            if (packet.MultipassOffset > 0)
+            {
+                var header = bytes.AsSpan(packet.AbsoluteDataOffset + packet.MultipassOffset * 16, 48).ToArray();
+                header.AsSpan(32, 4).Clear();
+                uvHeader = Convert.ToHexString(header);
+            }
+            foreach (var logical in strip.LogicalVertices)
+            {
+                var vertex = logical.DecodedVertex ?? throw new Exception("unresolved converted vertex");
+                var attributes = vertex.Bytes.ToArray();
+                attributes.AsSpan(6, 2).Clear();
+                attributes.AsSpan(attributes.Length - 2, 2).Clear();
+                var color = bases[logical.PacketIndex] + vertex.Index;
+                Expect(recipes.ContainsKey(color), $"lighting recipe covers cache slot {color}");
+                var uv = "";
+                if (packet.MultipassOffset > 0)
+                {
+                    var oldIndex = block.StripControls.Take(strip.PacketStripIndex).Sum(value => value.TokenCount) + logical.IndexInStrip;
+                    var offset = packet.AbsoluteDataOffset + packet.MultipassOffset * 16 + 48 + oldIndex % (packet.MultipassUvSize * 4) * 4;
+                    uv = Convert.ToHexString(bytes.AsSpan(offset, 4));
+                }
+                vertexKeys[logical.LogicalVertexIndex] = $"{vertex.Kind}:{Convert.ToHexString(attributes)}:{recipes[color]}:{glow.Contains(color)}:{uvHeader}:{uv}";
+            }
+        }
+        for (var index = 0; index < triangles.Count; index++)
+        {
+            var triangle = triangles[index];
+            var original = topology.Triangles[index];
+            if (Degenerate(topology, original)) continue;
+            var strip = topology.Strips[triangle.StripIndex];
+            var packet = tie.PacketTables[lod].Packets[strip.PacketIndex];
+            if (packet.BfcDistance == 0) triangle = original;
+            var keys = new[] { vertexKeys[triangle.A], vertexKeys[triangle.B], vertexKeys[triangle.C] };
+            if (packet.BfcDistance == 0) Array.Sort(keys, StringComparer.Ordinal);
+            var rotations = Enumerable.Range(0, 3).Select(start => string.Join('/', Enumerable.Range(0, 3).Select(i => keys[(start + i) % 3])));
+            var key = $"{strip.ShaderIndex}:{packet.BfcDistance}:{packet.PassFlags}:" + rotations.Min(StringComparer.Ordinal);
+            faces.Add(key);
+        }
+        return faces;
+    }
+
+    private static string Recipe(byte[] source, TieRgbaRemapOperation operation)
+    {
+        var size = operation.Kind is TieRgbaRemapOperationKind.WeightedAverage2To1To1 or TieRgbaRemapOperationKind.Average4 ? 8 : 4;
+        var bytes = source.AsSpan(operation.Offset, size).ToArray();
+        if (operation.Kind is TieRgbaRemapOperationKind.Average2 or TieRgbaRemapOperationKind.WeightedAverage3To1)
+            BinaryPrimitives.WriteUInt32LittleEndian(bytes, BinaryPrimitives.ReadUInt32LittleEndian(bytes) & ~0x3ffcu);
+        else
+            BinaryPrimitives.WriteUInt16LittleEndian(bytes.AsSpan(size - 2),
+                (ushort)(BinaryPrimitives.ReadUInt16LittleEndian(bytes.AsSpan(size - 2)) & ~0x3ffc));
+        return $"{operation.Kind}:{Convert.ToHexString(bytes)}";
+    }
+
+    private static bool Degenerate(TieLodTopology topology, TieTriangle triangle)
+    {
+        var a = topology.LogicalVertices[triangle.A].DecodedVertex!;
+        var b = topology.LogicalVertices[triangle.B].DecodedVertex!;
+        var c = topology.LogicalVertices[triangle.C].DecodedVertex!;
+        long x1 = b.X - a.X, y1 = b.Y - a.Y, z1 = b.Z - a.Z;
+        long x2 = c.X - a.X, y2 = c.Y - a.Y, z2 = c.Z - a.Z;
+        return y1 * z2 == z1 * y2 && z1 * x2 == x1 * z2 && x1 * y2 == y1 * x2;
+    }
+
+    private static TieClass Read(byte[] bytes, GameId game) => TieClassReader.Read(bytes,
+        TieClassReadOptions.ForGameProfile(TieGameProfile.ForGame(game)));
+    private static void Expect(bool condition, string message) { if (!condition) throw new Exception(message); }
+}
diff --git a/tests/RatchetPs2.LevelTests/GcTieConversionTests.cs b/tests/RatchetPs2.LevelTests/GcTieConversionTests.cs
new file mode 100644
index 0000000..18d8417
--- /dev/null
+++ b/tests/RatchetPs2.LevelTests/GcTieConversionTests.cs
@@ -0,0 +1,94 @@
+using System.Buffers.Binary;
+using RatchetPs2.Core.Games;
+using RatchetPs2.Core.Gltf;
+using RatchetPs2.Core.LevelAssets;
+using RatchetPs2.Core.Ties;
+using RatchetPs2.Sdk;
+
+internal static class GcTieConversionTests
+{
+    public static void Run()
+    {
+        var positions = new[] { 0f, 0f, 0f, 2f, 0f, 0f, 0f, 2f, 0f };
+        var normals = new[] { 0f, 0f, 1f, 0f, 0f, 1f, 0f, 0f, 1f };
+        var uv = new[] { 0f, 0f, 1f, 0f, 0f, 1f };
+        var asset = new StaticModelCanonicalAsset(StaticModelCanonicalFormat.Version,
+            [new(0, 0, "culled", 0, positions, normals, uv, null, [0u, 1u, 2u]),
+             new(1, 0, "two-sided", 1, [10f, 0f, 0f, 12f, 0f, 0f, 10f, 2f, 0f], normals, uv, null, [0u, 1u, 2u])],
+            [new(9729, 9729, 10497, 10497)], [new("texture", 0, 0)],
+            [new("culled", [1f, 1f, 1f, 1f], 0, 1, 1, "OPAQUE", 0.5f, false),
+             new("two-sided", [1f, 1f, 1f, 1f], 0, 1, 1, "OPAQUE", 0.5f, true)],
+            [new("white", 2, 2, Enumerable.Repeat((byte)255, 16).ToArray())], new(0, 0, 0, 12, 2, 0));
+        var native = StaticModelConverter.Convert(GameId.UYA, asset, 0xc6).ModelBytes;
+        var source = native.ToArray();
+        var tie = Read(native, GameId.UYA);
+        foreach (var block in tie.PacketDataBlocks)
+        {
+            source.AsSpan(tie.PacketTables[block.LodIndex].Packets[block.PacketIndex].AbsoluteDataOffset + 0x0c, 4).Clear();
+            foreach (var control in block.StripControls) source[control.Offset + 3] &= 0xdf;
+        }
+        var converted = LevelAssetModelConverter.Convert(GameId.GC, GameId.UYA, FrontendAssetKind.Tie, source, 0xc6);
+        var result = Read(converted, GameId.UYA);
+        var expectedBytes = native.ToArray();
+        var changed = 0;
+        foreach (var block in tie.PacketDataBlocks)
+        {
+            var culled = tie.PacketTables[block.LodIndex].Packets[block.PacketIndex].BfcDistance != 0;
+            foreach (var control in block.StripControls)
+            {
+                var expected = culled ? native[control.Offset + 3] : source[control.Offset + 3];
+                Expect(converted[control.Offset + 3] == expected, $"GC facing matches native UYA culling: expected {expected}, got {converted[control.Offset + 3]}");
+                if (converted[control.Offset + 3] != source[control.Offset + 3]) changed++;
+                expectedBytes[control.Offset + 3] = expected;
+            }
+        }
+        Expect(changed > 0, "fixture exercises a winding correction");
+        Expect(expectedBytes.AsSpan().SequenceEqual(converted), "only setup words and winding flags change, including preserved bfcDistance");
+        Expect(result.Header.OClass == 0xc6, "native class ID is retained");
+        Expect(tie.PacketTables.SelectMany(value => value.Packets).Any(value => value.BfcDistance == 0)
+            && tie.PacketTables.SelectMany(value => value.Packets).Any(value => value.BfcDistance != 0),
+            "fixture covers culled and two-sided packets");
+        var packet = tie.PacketTables[0].Packets[0];
+        for (byte shaders = 1; shaders <= 4; shaders++)
+        {
+            var multipleShaders = source.ToArray();
+            multipleShaders[checked((int)tie.Header.PacketTableOffsets[0]) + 4] = shaders;
+            for (var index = 0; index < 3; index++)
+                BinaryPrimitives.WriteInt32LittleEndian(multipleShaders.AsSpan(packet.AbsoluteDataOffset + index * 4),
+                    index < shaders - 1 ? 19 + 6 * index : 0);
+            var repairedSetup = LevelAssetModelConverter.Convert(GameId.GC, GameId.UYA,
+                FrontendAssetKind.Tie, multipleShaders, 0xc6);
+            Expect(BinaryPrimitives.ReadInt32LittleEndian(repairedSetup.AsSpan(packet.AbsoluteDataOffset + 0x0c))
+                == -(4 + 5 * shaders), "packet setup locates strip controls after every uploaded shader");
+        }
+        var previous = source.ToArray();
+        BinaryPrimitives.WriteUInt16LittleEndian(previous.AsSpan(0x44), 0x9009);
+        var repaired = LevelAssetModelConverter.RepairPreviousStaticConversion(GameId.GC, GameId.UYA,
+            FrontendAssetKind.Tie, source, previous, 0x9009, 0xc6);
+        Expect(repaired is not null && repaired.AsSpan().SequenceEqual(converted), "repair restores an old class allocation");
+        Expect(LevelAssetModelConverter.RepairPreviousStaticConversion(GameId.GC, GameId.UYA,
+            FrontendAssetKind.Tie, source, converted, 0xc6, 0xc6)!.AsSpan().SequenceEqual(converted), "repair is idempotent");
+        previous[^1] ^= 1;
+        Expect(LevelAssetModelConverter.RepairPreviousStaticConversion(GameId.GC, GameId.UYA,
+            FrontendAssetKind.Tie, source, previous, 0x9009, 0xc6) is null, "repair preserves independent model edits");
+        using var cancellation = new CancellationTokenSource();
+        cancellation.Cancel();
+        try
+        {
+            LevelAssetModelConverter.Convert(GameId.GC, GameId.UYA, FrontendAssetKind.Tie, source, 0xc6, cancellation.Token);
+            throw new Exception("Expected cancellation");
+        }
+        catch (OperationCanceledException) { }
+        GcTieSplitConversionTests.Run();
+        GcTieOverlapFacingTests.Run();
+        GcTieOddStripTests.Run();
+        Console.WriteLine("GC tie winding conversion tests passed.");
+    }
+
+    private static TieClass Read(byte[] bytes, GameId game) => TieClassReader.Read(bytes,
+        TieClassReadOptions.ForGameProfile(TieGameProfile.ForGame(game)));
+    private static void Expect(bool condition, string message)
+    {
+        if (!condition) throw new Exception(message);
+    }
+}
diff --git a/tests/RatchetPs2.LevelTests/GcTieOddStripTests.cs b/tests/RatchetPs2.LevelTests/GcTieOddStripTests.cs
new file mode 100644
index 0000000..7361708
--- /dev/null
+++ b/tests/RatchetPs2.LevelTests/GcTieOddStripTests.cs
@@ -0,0 +1,52 @@
+using System.Buffers.Binary;
+using RatchetPs2.Core.Games;
+using RatchetPs2.Core.Gltf;
+using RatchetPs2.Core.LevelAssets;
+using RatchetPs2.Core.Ties;
+using RatchetPs2.Sdk;
+
+internal static class GcTieOddStripTests
+{
+    public static void Run()
+    {
+        var asset = new StaticModelCanonicalAsset(StaticModelCanonicalFormat.Version,
+            [new(0, 0, "triangle", 0, [0f, 0f, 0f, 4f, 0f, 0f, 0f, 0f, 4f],
+                [0f, -1f, 0f, 0f, -1f, 0f, 0f, -1f, 0f], [0f, 0f, 1f, 0f, 0f, 1f], null, [0u, 1u, 2u])],
+            [new(9729, 9729, 10497, 10497)], [new("texture", 0, 0)],
+            [new("triangle", [1f, 1f, 1f, 1f], 0, 1, 1, "OPAQUE", 0.5f, false)],
+            [new("white", 2, 2, Enumerable.Repeat((byte)255, 16).ToArray())], new(0, 0, 0, 4, 0, 4));
+        var native = StaticModelConverter.Convert(GameId.UYA, asset, 0x10b).ModelBytes;
+        var tie = Read(native);
+        var block = tie.PacketDataBlocks.Single();
+        var packet = tie.PacketTables[0].Packets.Single();
+        var control = block.StripControls.Single();
+        var source = native.ToArray();
+        source[control.Offset] = 3;
+        // Keep the four-upload pipeline but make its padding overwrite the final real vertex.
+        BinaryPrimitives.WriteUInt16LittleEndian(source.AsSpan(packet.AbsoluteDataOffset + packet.VertexOffset * 16 + 3 * 16 + 6), 13);
+        source[packet.AbsoluteDataOffset + packet.ScissorOffset * 16 + 3] = 0xf6;
+        source.AsSpan(packet.AbsoluteDataOffset + 12, 4).Clear();
+        source[control.Offset + 3] &= 0xdf;
+        BinaryPrimitives.WriteInt16LittleEndian(source.AsSpan(0x60), 3);
+        BinaryPrimitives.WriteInt16LittleEndian(source.AsSpan(0x62), 1);
+        var converted = LevelAssetModelConverter.Convert(GameId.GC, GameId.UYA, FrontendAssetKind.Tie, source, 0x10b);
+        GcTieConversionAssertions.Equivalent(source, converted);
+        if (Read(converted).PacketDataBlocks.Any(value => value.StripControls.Any(strip => strip.TokenCount % 2 != 0)))
+            throw new Exception("Uniform-facing odd strips must be padded for UYA's paired culling loop.");
+        var previous = source.ToArray();
+        BinaryPrimitives.WriteInt32LittleEndian(previous.AsSpan(packet.AbsoluteDataOffset + 12), -9);
+        previous[control.Offset + 3] = native[control.Offset + 3];
+        var repaired = LevelAssetModelConverter.RepairPreviousStaticConversion(GameId.GC, GameId.UYA,
+            FrontendAssetKind.Tie, source, previous, 0x10b, 0x10b);
+        if (repaired is null || !repaired.AsSpan().SequenceEqual(converted))
+            throw new Exception("Previously unpadded conversions must repair automatically.");
+        previous[0x4c] ^= 1;
+        if (LevelAssetModelConverter.RepairPreviousStaticConversion(GameId.GC, GameId.UYA,
+            FrontendAssetKind.Tie, source, previous, 0x10b, 0x10b) is not null)
+            throw new Exception("Odd-strip repair must preserve independent model edits.");
+        Console.WriteLine("GC uniform odd strips pad safely and previous conversions repair without replacing edits.");
+    }
+
+    private static TieClass Read(byte[] bytes) => TieClassReader.Read(bytes,
+        TieClassReadOptions.ForGameProfile(TieGameProfile.ForGame(GameId.UYA)));
+}
diff --git a/tests/RatchetPs2.LevelTests/GcTieOverlapFacingTests.cs b/tests/RatchetPs2.LevelTests/GcTieOverlapFacingTests.cs
new file mode 100644
index 0000000..e0818b8
--- /dev/null
+++ b/tests/RatchetPs2.LevelTests/GcTieOverlapFacingTests.cs
@@ -0,0 +1,69 @@
+using System.Numerics;
+using RatchetPs2.Core.Games;
+using RatchetPs2.Core.Gltf;
+using RatchetPs2.Core.LevelAssets;
+using RatchetPs2.Core.Ties;
+using RatchetPs2.Sdk;
+
+internal static class GcTieOverlapFacingTests
+{
+    public static void Run()
+    {
+        var asset = new StaticModelCanonicalAsset(StaticModelCanonicalFormat.Version,
+            [new(0, 0, "overlapping", 0, [0f, 0f, 0f, 4f, 0f, 0f, 0f, 0f, 4f, 1f, 0f, 2f],
+                [0f, -1f, 0f, 0f, -1f, 0f, 0f, -1f, 0f, 0f, -1f, 0f],
+                [0f, 0f, 1f, 0f, 0f, 1f, 0.25f, 0.5f], null, [0u, 1u, 2u, 0u, 1u, 3u])],
+            [new(9729, 9729, 10497, 10497)], [new("texture", 0, 0)],
+            [new("overlapping", [1f, 1f, 1f, 1f], 0, 1, 1, "OPAQUE", 0.5f, false)],
+            [new("white", 2, 2, Enumerable.Repeat((byte)255, 16).ToArray())], new(0, 0, 0, 4, 0, 4));
+        var source = StaticModelConverter.Convert(GameId.UYA, asset, 0xbc).ModelBytes;
+        var native = Read(source, GameId.UYA);
+        foreach (var block in native.PacketDataBlocks)
+        {
+            source.AsSpan(block.Offset + 12, 4).Clear();
+            foreach (var control in block.StripControls) source[control.Offset + 3] &= 0xdf;
+        }
+        var preview = Read(source, GameId.GC);
+        var facing = TieGltfExporter.ResolveTriangleFacing(preview, 0, TieGameProfile.ForGame(GameId.GC));
+        Validate(preview.LodTopologies[0], facing);
+        var converted = LevelAssetModelConverter.Convert(GameId.GC, GameId.UYA, FrontendAssetKind.Tie, source, 0xbc);
+        GcTieConversionAssertions.Equivalent(source, converted);
+        var target = Read(converted, GameId.UYA);
+        Validate(target.LodTopologies[0], target.LodTopologies[0].Triangles);
+        var previous = converted.ToArray();
+        var second = target.LodTopologies[0].Strips.Where(strip => strip.TriangleCount > 0).Skip(1).First();
+        var block2 = target.PacketDataBlocks.Single(block => block.LodIndex == 0 && block.PacketIndex == second.PacketIndex);
+        previous[block2.StripControls[second.PacketStripIndex].Offset + 3] ^= 0x20;
+        var repaired = LevelAssetModelConverter.RepairPreviousStaticConversion(GameId.GC, GameId.UYA,
+            FrontendAssetKind.Tie, source, previous, 0xbc, 0xbc);
+        if (repaired is null || !repaired.AsSpan().SequenceEqual(converted))
+            throw new Exception("Earlier overlapping-face conversion must repair automatically.");
+        previous[0x4c] ^= 1;
+        if (LevelAssetModelConverter.RepairPreviousStaticConversion(GameId.GC, GameId.UYA,
+            FrontendAssetKind.Tie, source, previous, 0xbc, 0xbc) is not null)
+            throw new Exception("Overlap repair must preserve independently edited models.");
+        Console.WriteLine("GC overlapping coplanar faces retain their authored facing in preview, conversion and repair.");
+    }
+
+    private static void Validate(TieLodTopology topology, IReadOnlyList<TieTriangle> triangles)
+    {
+        var count = 0;
+        foreach (var triangle in triangles)
+        {
+            Vector3 Position(int index)
+            {
+                var vertex = topology.LogicalVertices[index].DecodedVertex!;
+                return GltfCoordinateBasis.FromPs2Position(vertex.X, vertex.Y, vertex.Z);
+            }
+            var normal = Vector3.Cross(Position(triangle.B) - Position(triangle.A),
+                Position(triangle.C) - Position(triangle.A));
+            if (normal.LengthSquared() == 0) continue;
+            if (normal.Y >= 0) throw new Exception("Overlapping faces must both point along their authored -Y normal.");
+            count++;
+        }
+        if (count != 2) throw new Exception("Overlap fixture must retain both rendered triangles.");
+    }
+
+    private static TieClass Read(byte[] bytes, GameId game) => TieClassReader.Read(bytes,
+        TieClassReadOptions.ForGameProfile(TieGameProfile.ForGame(game)));
+}
