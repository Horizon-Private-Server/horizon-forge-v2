+
+    private static byte[] RepeatedFixture(int count)
+    {
+        var template = Fixture(false);
+        var original = Read(template);
+        var packet = original.PacketDataBlocks.Single();
+        var data = 0x100 + count * 16;
+        var normal = data + packet.Length;
+        var remap = normal + 16;
+        var groups = (count + 15) / 16;
+        var remapSize = 32 + Enumerable.Range(0, groups).Sum(index => 16 + Math.Min(16, count - index * 16) * 8 * 4);
+        var shader = remap + remapSize;
+        var bytes = new byte[shader + 80];
+        template.AsSpan(0, 0x100).CopyTo(bytes);
+        bytes[12] = checked((byte)count);
+        I32(0x1c, shader); I32(0x34, normal); I16(0x24, count * 2);
+        I16(0x2a, 16); I16(0x78, 0);
+        I16(0x60, count * 8); I16(0x62, count * 4); I16(0x64, count * 2);
+        for (var index = 0; index < count; index++)
+        {
+            template.AsSpan(0x100, 16).CopyTo(bytes.AsSpan(0x100 + index * 16));
+            I32(0x100 + index * 16, data - 0x100);
+        }
+        packet.Bytes.CopyTo(bytes, data);
+        template.AsSpan((int)original.Header.VertexNormalsOffset, 8).CopyTo(bytes.AsSpan(normal));
+        var cursor = remap + 32;
+        for (var group = 0; group < groups; group++)
+        {
+            var slots = Math.Min(16, count - group * 16) * 8;
+            var length = 16 + slots * 4;
+            bytes[remap + group] = checked((byte)(length / 16));
+            I16(cursor, slots * 4); I16(cursor + 12, slots / 4); I16(cursor + 14, length);
+            for (var slot = 0; slot < slots; slot++) I16(cursor + 16 + slot * 4 + 2, slot * 4);
+            cursor += length;
+        }
+        template.AsSpan((int)original.Header.ShadersOffset, 80).CopyTo(bytes.AsSpan(shader));
+        return bytes;
+
+        void I32(int offset, int value) => BinaryPrimitives.WriteInt32LittleEndian(bytes.AsSpan(offset), value);
+        void I16(int offset, int value) => BinaryPrimitives.WriteUInt16LittleEndian(bytes.AsSpan(offset), checked((ushort)value));
+    }
+
+    private static TieClass Read(byte[] bytes) => TieClassReader.Read(bytes,
+        TieClassReadOptions.ForGameProfile(TieGameProfile.ForGame(GameId.GC)));
+    private static void Expect(bool condition, string message) { if (!condition) throw new Exception(message); }
+}
diff --git a/tests/RatchetPs2.LevelTests/GcTieVuUploadAssertions.cs b/tests/RatchetPs2.LevelTests/GcTieVuUploadAssertions.cs
new file mode 100644
index 0000000..2078f77
--- /dev/null
+++ b/tests/RatchetPs2.LevelTests/GcTieVuUploadAssertions.cs
@@ -0,0 +1,44 @@
+using RatchetPs2.Core.Ties;
+
+internal static class GcTieVuUploadAssertions
+{
+    public static void Validate(TiePacketDataBlock block)
+    {
+        var header = block.Bytes.AsSpan(0x20, 12);
+        var vertices = block.DecodedVertices;
+        var cursor = 0;
+        // Fast VU 0b40/0fc0 leave three/two prefetched dinky vertices after their stop markers.
+        Group(TiePacketDecodedVertexKind.Dinky, header[4], 3, shared: false);
+        if (header[0] == 0) Group(TiePacketDecodedVertexKind.Dinky, header[5], 2, shared: true);
+        if (cursor != header[10]) Fail("dinky loop reads past its upload group");
+        // Fast VU 1ab0/1c40 stop on the last single/shared fat vertex.
+        if (header[1] == 0)
+        {
+            Group(TiePacketDecodedVertexKind.Fat, header[6], 0, shared: false);
+            Group(TiePacketDecodedVertexKind.Fat, header[7], 0, shared: true);
+        }
+        if (cursor != vertices.Count) Fail("fat loop reads past its upload group");
+
+        void Group(TiePacketDecodedVertexKind kind, int stop, int tail, bool shared)
+        {
+            var found = false;
+            while (!found)
+            {
+                var vertex = Next();
+                found = vertex.GsPacketWriteOffset == stop;
+            }
+            for (var index = 0; index < tail; index++) Next();
+
+            TiePacketDecodedVertex Next()
+            {
+                if (cursor >= vertices.Count) Fail("VU loop does not reach its stop marker");
+                var vertex = vertices[cursor++];
+                if (vertex.Kind != kind || (vertex.SecondaryGsPacketWriteOffset != 0) != shared)
+                    Fail("VU loop consumes the wrong vertex kind or write mode");
+                return vertex;
+            }
+        }
+
+        void Fail(string message) => throw new Exception($"LOD {block.LodIndex} packet {block.PacketIndex}: {message}");
+    }
+}
