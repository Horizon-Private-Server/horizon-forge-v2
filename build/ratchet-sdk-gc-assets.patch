@@ -0,0 +1,30 @@
+using RatchetPs2.Games.UYA.Level;
+
+namespace RatchetPs2.Games.GC.Level;
+
+internal static class GcLevelArchiveReader
+{
+    public static IReadOnlyList<int> FindAvailable(Stream iso)
+    {
+        ArgumentNullException.ThrowIfNull(iso);
+        var levels = new List<int>();
+        foreach (var level in GcLevelCatalog.Levels)
+        {
+            var block = GcLevelInfoReader.ReadLevel(iso, level.Id).LevelWad;
+            if (block.Offset < 0 || block.Length < 0)
+                throw new InvalidDataException("GC level WAD contains negative sector values.");
+            if (block.Offset != 0 && block.Length != 0) levels.Add(level.Id);
+        }
+        return levels;
+    }
+
+    public static byte[] ExtractPrimary(Stream iso, int level)
+    {
+        var entry = GcLevelInfoReader.ReadLevel(iso, level);
+        return UyaLooseLevelWadExtractor.ExtractPrimary(iso, new UyaLevelInfoSet(
+            entry.Level.TableIndex, new UyaLevelInfoEntry(entry.Level.TableIndex,
+                new(entry.LevelAudioWad.Offset, entry.LevelAudioWad.Length),
+                new(entry.LevelWad.Offset, entry.LevelWad.Length),
+                new(entry.LevelSceneWad.Offset, entry.LevelSceneWad.Length)))).Bytes;
+    }
+}
diff --git a/src/RatchetPs2.Games.GC/Level/GcLevelAssetCanonicalizer.cs b/src/RatchetPs2.Games.GC/Level/GcLevelAssetCanonicalizer.cs
new file mode 100644
index 0000000..3e2c93e
--- /dev/null
+++ b/src/RatchetPs2.Games.GC/Level/GcLevelAssetCanonicalizer.cs
@@ -0,0 +1,33 @@
+using RatchetPs2.Core.LevelAssets;
+
+namespace RatchetPs2.Games.GC.Level;
+
+public static class GcLevelAssetCanonicalizer
+{
+    public static byte[] NormalizeDefinition(ReadOnlySpan<byte> definitionBytes)
+    {
+        ValidateDefinition(definitionBytes);
+        var definition = definitionBytes.ToArray();
+        definition.AsSpan(0, 8).Clear();
+        definition.AsSpan(0x10).Fill(byte.MaxValue);
+        return definition;
+    }
+
+    public static void Validate(
+        ReadOnlySpan<byte> definitionBytes,
+        ReadOnlySpan<byte> modelBytes,
+        IReadOnlyList<FrontendAssetTexture> textures)
+    {
+        ValidateDefinition(definitionBytes);
+        if (modelBytes.IsEmpty) throw new InvalidDataException("Canonical GC model cannot be empty.");
+        ArgumentNullException.ThrowIfNull(textures);
+        if (textures.Count > 4_096 || textures.Any(value => value is null || value.Role > 1 || value.PifBytes.Length == 0))
+            throw new InvalidDataException("Canonical GC textures are invalid.");
+    }
+
+    private static void ValidateDefinition(ReadOnlySpan<byte> definitionBytes)
+    {
+        if (definitionBytes.Length is not 0x20 and not 0x30)
+            throw new InvalidDataException("Canonical GC definition must be 0x20 or 0x30 bytes.");
+    }
+}
diff --git a/src/RatchetPs2.Games.GC/Level/GcLevelAssetExtractor.cs b/src/RatchetPs2.Games.GC/Level/GcLevelAssetExtractor.cs
new file mode 100644
