<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <Import Project="../../build/RatchetSdk.props" />

  <PropertyGroup Condition="'$(ForgeEnableOcclusionCoveragePreview)' == 'true'">
    <DefineConstants>$(DefineConstants);FORGE_OCCLUSION_COVERAGE_PREVIEW</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ForgeEnableOcclusionCoverageGeneration)' == 'true'">
    <DefineConstants>$(DefineConstants);FORGE_OCCLUSION_COVERAGE_GENERATION</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(ForgeEnableOcclusionCoverageGraphShapes)' == 'true'">
    <DefineConstants>$(DefineConstants);FORGE_OCCLUSION_COVERAGE_GRAPH_SHAPES</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RatchetSdkRoot)/tests/RatchetPs2.LevelTests/Fixtures/LevelContent/*.bin"
          Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(RatchetSdkRoot)/tests/RatchetPs2.LevelTests/Fixtures/LevelContent/*.wad"
          Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <ProjectReference Include="../../src/Forge.Host/Forge.Host.csproj" />
    <ProjectReference Include="../../src/Forge.Updater/Forge.Updater.csproj" />
    <None Include="../fixtures/bridge-v6.json" Link="fixtures/bridge-v6.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/editor-asset-source-v6.json" Link="fixtures/editor-asset-source-v6.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/identity-v0.json" Link="fixtures/identity-v0.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/rc1-tie.bin" Link="fixtures/rc1-tie.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/gc-folded-tie.bin" Link="fixtures/gc-folded-tie.bin" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/occlusion-coverage-preview-graph-v1.json" Link="fixtures/occlusion-coverage-preview-graph-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/occlusion-coverage-preview-v1.json" Link="fixtures/occlusion-coverage-preview-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/occlusion-coverage-v1.json" Link="fixtures/occlusion-coverage-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/occlusion-coverage-sticky-v1.json" Link="fixtures/occlusion-coverage-sticky-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/occlusion-coverage-volume-graphs-v1.json" Link="fixtures/occlusion-coverage-volume-graphs-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/project-v0.json" Link="fixtures/project-v0.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../fixtures/mobydex-v1.json" Link="fixtures/mobydex-v1.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../docs/schemas/mobydex-v1.schema.json" Link="fixtures/mobydex-v1.schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
